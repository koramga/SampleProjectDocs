rce="S-c3mc" target="S-c3md"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e15" label="컴포넌트 [QA 통과]" carries="컴포넌트 [QA 통과]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c3md" target="S-c3e2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e16" label="요구 기록 [승인됨]·계획 답" carries="요구 기록 [승인됨]·계획 답"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c5e1" target="S-c5mu"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e17" label="맞춘 라이브러리 [QA 통과]" carries="맞춘 라이브러리 [QA 통과]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c5mu" target="S-c5mi"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e18" label="진짜 명령·계산 모듈 [QA 통과]" carries="진짜 명령·계산 모듈 [QA 통과]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c5mi" target="S-c5e2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e19" label="요구 기록 [승인됨]" carries="요구 기록 [승인됨]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c6e1" target="S-c6gd"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e20" label="게임 기획서 [공동 검토 통과](데이터 스키마가 바뀔 때)" carries="게임 기획서 [공동 검토 통과](데이터 스키마가 바뀔 때)"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c6gd" target="S-c6dc"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e21" label="게임 기획서 [공동 검토 통과](보이고 들리는 것이 바뀔 때)" carries="게임 기획서 [공동 검토 통과](보이고 들리는 것이 바뀔 때)"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c6gd" target="S-c6ga"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e22" label="게임 기획서·닫기 전 사례 [골라짐]" carries="게임 기획서·닫기 전 사례 [골라짐]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c6gd" target="S-c6gi"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e23" label="게임 기획서(바닐라 값을 바꿀 때)" carries="게임 기획서(바닐라 값을 바꿀 때)"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c6gd" target="S-c6gv"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e24" label="데이터 계약 [정해짐]" carries="데이터 계약 [정해짐]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c6dc" target="S-c6gi"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e25" label="자산 계열과 모양 [정해짐]" carries="자산 계열과 모양 [정해짐]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c6ga" target="S-c6gi"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e26" label="게임 구현 [QA 통과]" carries="게임 구현 [QA 통과]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c6gi" target="S-c6gp"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e27" label="바닐라 데이터 [QA 통과]" carries="바닐라 데이터 [QA 통과]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c6gv" target="S-c6gp"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e28" label="플레이 판정 [판정됨]과 까닭" carries="플레이 판정 [판정됨]과 까닭"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c6gp" target="S-c6e2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e29" label="요구 기록 [승인됨]" carries="요구 기록 [승인됨]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c7e1" target="S-c7po"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e30" label="PoC 판정 [판정됨]·판정 자료" carries="PoC 판정 [판정됨]·판정 자료"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c7po" target="S-c7e2"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="S-n0" value="워크플로우 목록(맡은 Lead → 출력 [상태])&#xa;도구 구조(MT) · Lead Mod Tool Engineer → 구조 결정 [정해짐] 버전. 사용자가 확인하면 [승인됨]&#xa;AI 기능 기획(MA) · Lead Mod Tool Designer → MCP 기획서 [공동 검토 통과] 버전&#xa;명령 계약(MK) · Lead Mod Tool Engineer → 명령 계약 [정해짐] 버전, 명령 층 사례 [골라짐] 버전, 가짜 명령 [사례 통과] 버전&#xa;화면 기획(MP) · Lead Mod Tool Designer → 화면 기획서 [공동 검토 통과] 버전, 화면 사례 [골라짐] 버전&#xa;컴포넌트 기획(MC) · Lead Mod Tool Designer → 컴포넌트 기획서 [공동 검토 통과] 버전(그림 확인을 고른 것은 [승인됨] 버전), 컴포넌트 사례 [골라짐] 버전&#xa;컴포넌트 개발(MD) · Lead Mod Tool Engineer → 컴포넌트 [QA 통과] 버전. Storybook 확인을 고른 것은 [승인됨]. 화면 조립에 쓰는 컴포넌트는 [넣음] 버전&#xa;화면 조립과 승인(MS) · Lead Mod Tool Designer → 화면 [승인됨] 버전, 화면 스펙과 동작 표 [승인됨] 커밋, 승인에서 바뀐 컴포넌트 목록, 판정 예시&#xa;화면 마무리(MF) · Lead Mod Tool Engineer → 제품 화면 [QA 통과] 버전, 새로 만든 컴포넌트 [QA 통과] 버전&#xa;AI 기능 구현(MI) · Lead Mod Tool Engineer → 진짜 명령·계산 모듈 [QA 통과] 버전&#xa;Unreal 맞춤(MU) · Lead Mod Tool Engineer → 맞춘 라이브러리 [QA 통과] 버전&#xa;데이터 계약(DC) · Lead Data Modeler → 데이터 계약 [정해짐] 버전과 해시, 스키마 문서 커밋. 줄이기를 하면 줄인 데이터 계약 [정해짐] 버전&#xa;게임 기획(GD) · Lead Designer → 게임 기획서 [공동 검토 통과] 버전, 닫기 전 사례 [골라짐] 버전&#xa;게임의 모양과 자산(GA) · Lead Art Director → 자산 계열과 모양 [정해짐] 버전. 화풍·손맛 판정이 걸리면 [승인됨]&#xa;게임 구현(GI) · Lead Unreal Engineer → 게임 구현 [QA 통과] 버전(main 커밋)&#xa;바닐라 데이터(GV) · Lead Designer → 바닐라 데이터 [QA 통과] 버전(레이어 db의 main 커밋)&#xa;PoC(PO) · 질문을 가진 Lead → PoC 판정 [판정됨]과 까닭, 판정 자료(판정하는 사람이 보거나 플레이한 목업·영상·빌드)&#xa;플레이 판정(GP) · Lead Designer → 플레이 판정 [판정됨]과 까닭" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="896" width="1700" height="250" as="geometry"/></mxCell><mxCell id="S-n1" value="잇는 규칙과 상태&#xa;입력·출력은 「산출물 [상태] 버전」. 상태는 공동 검토 통과, 정해짐, 골라짐, 사례 통과, QA 통과, 승인됨, Lead Designer 검수, 판정됨, 넣음의 아홉이다.&#xa;QA 통과: 남은 결함이 있으면 그 결함과 심각도를 적고, 받아들일지는 그 출력을 받는 판정 단계나 에픽 끝이 정한다. 승인됨: 사용자(사용자가 그 확인을 PD에게 맡겼으면 PD)가 확인함(요구 확정, 컴포넌트 그림 확인, 화면 승인, Storybook 확인, 큰 그림 확인, 구조 결정 확인). 판정 코멘트가 「다르다」를 낸 줄과 받을 검수를 정하고 다시 보지 않기로 적었으면 그 검수를 받은 고친 버전도 [승인됨]이다.&#xa;다른 단위 워크플로우에서 오는 일과 되돌림은 받는 단위 워크플로우의 시작으로만 들어가고 입력·출력 표의 출력으로만 나간다. 출력은 그 출력의 끝 판정이 끝나면 나간다. 안의 어느 단계부터 다시 할지는 맡은 Lead가 정한다.&#xa;모든 출력에는 받는 곳(단위 워크플로우, 에픽 끝, 「사람이 확인한 예시」 자리, 다음 에픽의 요구 확정)이, 모든 입력에는 내는 곳(단위 워크플로우, 요구 기록, 계획 확정)이 있다. 에픽 워크플로우의 마지막 출력은 에픽 끝이 받는다.&#xa;계획 때 입력 대조는 도구가 하고, 도구가 생기기 전에는 Lead PM이 한다. 인스턴스를 시작하는 Lead는 받은 입력의 버전을 적고, 필수 입력이 없거나 상태가 다르면 시작하지 않고 Blocks로 미루거나 묻는다. 기본값으로 채우지 않는다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="1160" width="1700" height="124" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="E" name="에픽의 앞과 끝"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="E-title" value="에픽의 앞과 끝&#xa;모든 에픽은 요구 확정과 계획 확정으로 시작해 에픽 끝으로 닫힌다. 넷을 하는 담당은 모두 Lead PM이다. 회색 점선 상자는 승인이고, 그 띠가 승인하는 담당이다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1430" height="50" as="geometry"/></mxCell><mxCell id="E-sig-in" value="입력(요구 확정과 계획 확정이 받는 것)&#xa;사용자의 요청(원래 말과 출처)&#xa;사용자 · 필수. 다른 세션이 받은 말도 모은다&#xa;현황 조사 결과&#xa;부른 Lead(하위) · 조건부(크기나 대상을 모를 때). 요구 확정의 입력&#xa;부른 Lead들의 계획 답(과업 나누기, 추정)&#xa;부른 Lead · 계획 확정에서 필수. 입력·출력을 Lead만 적을 수 있으면 요구 확정 전에&#xa;앞 에픽의 PoC 판정 [판정됨]의 「가치 있다」와 판정 자료&#xa;PoC(PO) · 조건부(그 생각을 만드는 에픽일 때). 요구 확정의 입력" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="670" height="188.3" as="geometry"/></mxCell><mxCell id="E-sig-out" value="출력(에픽 끝이 내는 것)&#xa;인수안&#xa;받는 곳: 사용자(에픽을 닫는 것과 남은 위험을 승인한다)&#xa;측정 값(남은 보장 결함, 기다린 시간의 비율, 독립 QA 뒤 고침 하위 수)&#xa;받는 곳: PD(흐름을 다시 그릴지 정한다) · 인수 코멘트&#xa;에픽 워크플로우가 맞지 않았던 곳&#xa;받는 곳: PD(단위 워크플로우를 고칠지 정한다) · 인수 코멘트" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="776" y="66" width="670" height="188.3" as="geometry"/></mxCell><mxCell id="E-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="E-sig-in" target="E-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="E-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=170;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="278.3" width="1462" height="110" as="geometry"/></mxCell></object><object id="E-lane-D" label="요구 기록의 정하는 사람(사용자, 운영을 맡겼으면 PD)" lane="요구 기록의 정하는 사람(사용자, 운영을 맡겼으면 PD)"><mxCell style="swimlane;horizontal=0;startSize=170;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="388.3" width="1462" height="150" as="geometry"/></mxCell></object><object id="E-lane-PM" label="Lead PM" lane="Lead PM"><mxCell style="swimlane;horizontal=0;startSize=170;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="538.3" width="1462" height="290" as="geometry"/></mxCell></object><object id="E-lane-L" label="부른 Lead" lane="부른 Lead"><mxCell style="swimlane;horizontal=0;startSize=170;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="828.3" width="1462" height="150" as="geometry"/></mxCell></object><object id="E-survey" label="현황 조사&#xa;위 입력 둘째 줄"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-L"><mxGeometry x="186" y="15" width="186" height="120" as="geometry"/></mxCell></object><object id="E-plans" label="계획 답&#xa;위 입력 셋째 줄"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-L"><mxGeometry x="396" y="15" width="186" height="120" as="geometry"/></mxCell></object><object id="E-E3" label="요구 확정&#xa;(E-3)&#xa;넘김: 요구 기록 [승인됨] 버전(버전을 단 에픽 첨부), 사용자 확인 기록" step="(E-3)"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-PM"><mxGeometry x="396" y="14" width="186" height="120" as="geometry"/></mxCell></object><object id="E-E1" label="계획 확정&#xa;(E-1)&#xa;넘김: 에픽의 현재 계획 코멘트의 에픽 워크플로우 표, 하위, Blocks. 함께 쓰는 형이 있으면 기술 계약 하위" step="(E-1)"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-PM"><mxGeometry x="606" y="14" width="186" height="120" as="geometry"/></mxCell></object><object id="E-WF" label="에픽 워크플로우&#xa;고른 단위 워크플로우의 인스턴스들. 판정 단계의 「다르다」로 고치는 것은 되돌림이다. 받는 곳이 에픽 끝인 출력과 마지막 출력은 에픽 끝으로 간다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-PM"><mxGeometry x="816" y="14" width="186" height="130" as="geometry"/></mxCell></object><object id="E-E4" label="계획 다시 확정&#xa;(E-4)&#xa;넘김: 요구 기록 새 버전과 그 채택 코멘트, 고친 에픽 워크플로우 표" step="(E-4)"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-PM"><mxGeometry x="816" y="170" width="186" height="120" as="geometry"/></mxCell></object><object id="E-STOP" label="멈춤&#xa;목표에 「아니오」가 나오거나 요구 기록의 정하는 사람이 멈추기로 함. 새 인스턴스를 시작하지 않고 PD에게 알린다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-PM"><mxGeometry x="1026" y="170" width="186" height="120" as="geometry"/></mxCell></object><object id="E-E2" label="에픽 끝&#xa;(E-2)&#xa;넘김: 인수안, 측정 값, 에픽 워크플로우가 맞지 않았던 곳" step="(E-2)"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-PM"><mxGeometry x="1236" y="14" width="186" height="120" as="geometry"/></mxCell></object><object id="E-IN4" label="계획 다시 확정에 드는 때&#xa;진행 중 새 요구나 범위 · 넘는 몫을 바꿀 하위를 시작할 때 다시 잰 크기가 위 끝을 넘음 · 목표, 완료 조건, 필수 사례, 목표 품질, 확인한 요구 기록 줄의 뜻이 바뀜 · 멈춘 에픽을 다시 시작함"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="E-lane-L"><mxGeometry x="816" y="10" width="186" height="130" as="geometry"/></mxCell></object><object id="E-aE3" label="승인 · 요구 기록 전체"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-U"><mxGeometry x="396" y="25" width="186" height="60" as="geometry"/></mxCell></object><object id="E-aE1" label="승인 · 바닥 위로 올리거나 사람이 보는 것에만 기대는 출력의 목표 품질"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-D"><mxGeometry x="606" y="37" width="186" height="76" as="geometry"/></mxCell></object><object id="E-aE4" label="승인 · 목표, 완료 조건, 필수 사례, 위 끝, 목표 품질 올림, 확인한 줄의 뜻을 바꿀 때만"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-D"><mxGeometry x="816" y="10" width="186" height="130" as="geometry"/></mxCell></object><object id="E-aST" label="멈춤, 다시 시작, 남은 범위를 정함"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-D"><mxGeometry x="1026" y="45" width="186" height="60" as="geometry"/></mxCell></object><object id="E-aE2" label="승인 · 에픽을 닫는 것과 남은 위험(모딩 툴이면 한 바퀴 판정)"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="E-lane-U"><mxGeometry x="1236" y="17" width="186" height="76" as="geometry"/></mxCell></object><object id="E-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="E-survey" target="E-E3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="E-plans" target="E-E1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="E-plans" target="E-E3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="E-E3" target="E-E1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="E-E1" target="E-WF"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e5" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="E-WF" target="E-E2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e6" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="E-IN4" target="E-E4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e7" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="E-E4" target="E-WF"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e8" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="E-WF" target="E-STOP"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="E-e9" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="E-STOP" target="E-E4"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="E-n0" value="이 페이지의 규칙&#xa;요구 기록의 정하는 사람은 사용자이고, 사용자가 그 에픽의 운영을 PD에게 맡겼으면 맡긴 범위 안에서는 PD다. PD가 정하면 사용자에게 알린다.&#xa;요구 기록의 현재 버전은 그 버전 이름을 적은 마지막 채택 코멘트가 가리키는 버전이다. 채택 코멘트는 「사용자 확인」, 확인 뒤에 그 확인을 담아 첨부한 버전과 확인 코멘트를 함께 적은 코멘트, Lead PM이나 맡은 PD의 「판단」 셋이다. Lead PM이 확인한 줄의 뜻 안에서 고친 버전은 [정해짐]이다.&#xa;확인한 줄이 지키려는 것과 사람이 판단할 것을 바꾸지 않고 칸·값을 더하거나 조건을 고치는 것, 위 끝 안의 하위·Blocks·계약 버전 더하기는 계획 다시 확정이 아니다. Lead PM이 정하고 알린다.&#xa;판정 단계의 「다르다」로 고치는 것은 되돌림이고, 요구 기록 줄의 뜻이나 목표·완료 조건을 바꿀 때만 계획 다시 확정이다. 다시 시작은 계획 다시 확정으로 한다." style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="186" y="994.3" width="1220" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MT" name="도구 구조 (MT)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MT-title" value="도구 구조 (MT)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="MT-sig-in" value="입력&#xa;없음 · 계획 확정(E-1)에서 시작&#xa;에픽 워크플로우가 이 단위 워크플로우를 고르면 시작한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="161" as="geometry"/></mxCell><mxCell id="MT-sig-out" value="출력&#xa;구조 결정 [정해짐] 버전(사용자가 확인하면 [승인됨])&#xa;받는 곳: 코드를 쓰는 단위 워크플로우의 조건부 입력: 컴포넌트 개발(MD), 화면 조립과&#xa;승인(MS), AI 기능 구현(MI), 화면 마무리(MF), Unreal 맞춤(MU)(그 에픽이 구조를 고쳤을&#xa;때). 사례를 고르는 단위 워크플로우의 조건부 입력: 명령 계약(MK), 컴포넌트 기획(MC)(그&#xa;구조를 검사하는 사례를 고를 때)&#xa;출력 요구: 나누는 단위, 경계를 막는 장치, 단위 사이 의존. 구조 학습 결과를 사용자가&#xa;확인할 때까지 계산 모듈, 진짜 명령, 컴포넌트의 동작과 모양, 게임 기록 대조, 조립 검수의&#xa;코드 하위와 QA 사례 하위를 새로 시작하지 않았다(GRAVEN-2237 2026-10-31 05:32)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="161" as="geometry"/></mxCell><mxCell id="MT-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MT-sig-in" target="MT-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MT-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="251" width="1182" height="122" as="geometry"/></mxCell></object><object id="MT-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="373" width="1182" height="130" as="geometry"/></mxCell></object><object id="MT-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MT-lane-LMTE"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MT-MT-1" label="구조 결정 정해짐&#xa;(MT-1)&#xa;넘김: 구조 결정 문서와 커밋" step="(MT-1)" owner="Lead Mod Tool Engineer" approve="없음" input="없음" handsOver="구조 결정 문서와 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MT-lane-LMTE"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MT-MT-2" label="사용자가 구조 결정을 확인함&#xa;(MT-2)&#xa;넘김: 사용자 확인 기록&#xa;빠지는 때: 요구 기록에 없는 사용자 결정이나 PD 판단에 닿지 않으면" step="(MT-2)" owner="사용자" approve="사용자" input="Lead Mod Tool Engineer(결정과 닿는 사용자 결정·PD 판단)" handsOver="사용자 확인 기록" skipWhen="요구 기록에 없는 사용자 결정이나 PD 판단에 닿지 않으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MT-lane-U"><mxGeometry x="566" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MT-rMT-2LMTE" label="입력 · 결정과 닿는 사용자 결정·PD 판단"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MT-lane-LMTE"><mxGeometry x="566" y="37" width="176" height="56" as="geometry"/></mxCell></object><object id="MT-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MT-lane-LMTE"><mxGeometry x="766" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MT-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MT-in" target="MT-MT-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MT-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MT-MT-1" target="MT-MT-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MT-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MT-MT-2" target="MT-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MT-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Engineer&#xa;쓰는 때: 모딩 툴을 처음 만들거나, 나누는 단위와 경계를 바꿀 때&#xa;끝 판정: 구조 결정 정하기(MT-1). 요구 기록에 없는 사용자 결정이나 PD 판단에 닿으면 구조 결정 확인(MT-2). 보장하는 것: 그 버전의 구조 결정을 맡은 Lead가 적었고, 닿는 경우 사용자가 확인했다&#xa;정해 둔 자리: 목표 품질: Quality.md 「목표 품질을 고르는 기준」대로 고른다. 빠지는 때: 구조 결정 확인(MT-2)은 구조 결정이 요구 기록에 없는 사용자 결정이나 PD 판단에 닿을 때만 둔다. 요구 확정에서 사용자가 확인한 경계를 옮긴 구조 결정이면 빠진다(GRAVEN-2405 09:18). 더하는 사용자 확인: 구조 결정 확인(MT-2)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="519" width="970" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MA" name="AI 기능 기획 (MA)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MA-title" value="AI 기능 기획 (MA)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="MA-sig-in" value="입력&#xa;없음 · 계획 확정(E-1)에서 시작&#xa;에픽 워크플로우가 이 단위 워크플로우를 고르면 시작한다&#xa;게임 기획서 [공동 검토 통과] 버전&#xa;게임 기획(GD) · 선택(게임의 뜻을 가리킬 때)&#xa;화면 기획이 돌려준 값(명령 계약에 없는 값)&#xa;화면 기획(MP) · 되돌림" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="150.60000000000002" as="geometry"/></mxCell><mxCell id="MA-sig-out" value="출력&#xa;MCP 기획서 [공동 검토 통과] 버전&#xa;받는 곳: 명령 계약(MK) 필수, 데이터 계약(DC) 조건부(데이터 스키마가 바뀔 때)&#xa;출력 요구: 기능마다 거부 까닭과 관찰 칸. 명령 계약에서 계약 조항이 되므로 계약 전에&#xa;물어야 실행 전에 만들어진다(Game Testing All in One PDF 쪽 339, GRAVEN-2346 21955&#xa;7절 2)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="150.60000000000002" as="geometry"/></mxCell><mxCell id="MA-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MA-sig-in" target="MA-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MA-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="240.60000000000002" width="1182" height="122" as="geometry"/></mxCell></object><object id="MA-lane-LMTD" label="Lead Mod Tool Designer" lane="Lead Mod Tool Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="362.6" width="1182" height="130" as="geometry"/></mxCell></object><object id="MA-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="492.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="MA-lane-LUE" label="Lead Unreal Engineer" lane="Lead Unreal Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="614.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="MA-lane-LDM" label="Lead Data Modeler" lane="Lead Data Modeler"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="736.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="MA-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="858.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="MA-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LMTD"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MA-MA-1" label="MCP 기획서 작성됨&#xa;(MA-1)&#xa;넘김: 기획서 버전, design 확인 기록, 검토 요청 코멘트" step="(MA-1)" owner="Lead Mod Tool Designer" approve="없음" input="Lead Designer(게임의 뜻은 게임 기획서의 줄을 가리킨다)" handsOver="기획서 버전, design 확인 기록, 검토 요청 코멘트" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LMTD"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MA-rMA-1LD" label="입력 · 게임의 뜻은 게임 기획서의 줄을 가리킨다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LD"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MA-MA-2" label="공동 검토됨&#xa;(MA-2)&#xa;넘김: 기획서 [공동 검토 통과] 버전, 담당마다 확인 기록" step="(MA-2)" owner="Lead Mod Tool Designer" approve="Lead Mod Tool Engineer, Lead QA Engineer, Lead Unreal Engineer(게임과 같아야 하는 계산이 있을 때)" input="Lead Data Modeler(데이터 스키마(테이블과 열)가 바뀔 때)" handsOver="기획서 [공동 검토 통과] 버전, 담당마다 확인 기록" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LMTD"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MA-rMA-2LMTE" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LMTE"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MA-rMA-2QA" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-QA"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MA-rMA-2LUE" label="승인 · 게임과 같아야 하는 계산이 있을 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LUE"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MA-rMA-2LDM" label="입력 · 데이터 스키마(테이블과 열)가 바뀔 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LDM"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MA-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MA-lane-LMTD"><mxGeometry x="766" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MA-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MA-in" target="MA-MA-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MA-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MA-MA-1" target="MA-MA-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MA-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MA-MA-2" target="MA-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MA-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Designer&#xa;쓰는 때: AI가 쓰는 기능(MCP)을 새로 두거나 바꿀 때. 질문 「사람이나 AI가 모딩 툴에서 하는 일이 바뀌는가」&#xa;끝 판정: 공동 검토(MA-2). 보장하는 것: 승인 담당의 체크리스트 줄마다 그 버전의 기획서에 답이 있고 출력 요구가 채워졌다&#xa;정해 둔 자리: 목표 품질: 프로덕션이 바닥이다(Quality.md 「목표 품질을 고르는 기준」). 빠지는 때와 더하는 사용자 확인: 없음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="996.6" width="970" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MK" name="명령 계약 (MK)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MK-title" value="명령 계약 (MK)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="MK-sig-in" value="입력&#xa;MCP 기획서 [공동 검토 통과] 버전&#xa;AI 기능 기획(MA) · 필수&#xa;데이터 계약 [정해짐] 버전&#xa;데이터 계약(DC) · 조건부(데이터 스키마가 바뀔 때)&#xa;화면 사례 [골라짐] 버전&#xa;화면 기획(MP) · 조건부(가짜 명령 위에서 화면을 승인할 때)&#xa;구조 결정 [정해짐] 버전(사용자가 확인했으면 [승인됨])&#xa;도구 구조(MT) · 조건부(그 에픽이 구조를 고쳤고, 그 구조를 검사하는 사례를 고를 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="250.70000000000005" as="geometry"/></mxCell><mxCell id="MK-sig-out" value="출력&#xa;명령 계약 [정해짐] 버전&#xa;받는 곳: AI 기능 구현(MI) 필수, 화면 기획(MP) 선택(이미 있을 때)&#xa;출력 요구: MCP 기획서의 기능마다 명령, 거부 까닭이 나오는 자리, 관찰 칸&#xa;명령 층 사례 [골라짐] 버전&#xa;받는 곳: AI 기능 구현(MI) 필수&#xa;출력 요구: 사례가 데이터를 읽으면 그 데이터를 만든 레이어 묶음(월드들과 차례,&#xa;Experience, 모드 목록)과 데이터 버전&#xa;가짜 명령 [사례 통과] 버전&#xa;받는 곳: 화면 조립과 승인(MS) 필수(진짜 명령과 둘 가운데 하나), AI 기능 구현(MI)&#xa;조건부(가짜 명령이 있을 때)&#xa;출력 요구: 가짜가 담은 갈래. 화면 사례를 받았으면 그 가운데 가짜로 누르는 줄의 갈래를&#xa;담는다. 가짜는 거부 갈래 가운데 일부만 두기로 정해져 있어 담은 갈래를 적어야 진짜와&#xa;대조할 수 있다(GRAVEN-2349 22226 6)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="250.70000000000005" as="geometry"/></mxCell><mxCell id="MK-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MK-sig-in" target="MK-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MK-lane-LMTD" label="Lead Mod Tool Designer" lane="Lead Mod Tool Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="340.70000000000005" width="1182" height="122" as="geometry"/></mxCell></object><object id="MK-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="462.70000000000005" width="1182" height="130" as="geometry"/></mxCell></object><object id="MK-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="592.7" width="1182" height="122" as="geometry"/></mxCell></object><object id="MK-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MK-lane-LMTE"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MK-MK-1" label="명령 계약 정해짐&#xa;(MK-1)&#xa;넘김: Jira 현재 계약 코멘트의 버전" step="(MK-1)" owner="Lead Mod Tool Engineer" approve="Lead Mod Tool Designer(기능마다 명령이 있는지 대조)" input="Lead QA Engineer(관찰 칸)" handsOver="Jira 현재 계약 코멘트의 버전" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MK-lane-LMTE"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MK-rMK-1LMTD" label="승인 · 기능마다 명령이 있는지 대조"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MK-lane-LMTD"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MK-rMK-1QA" label="입력 · 관찰 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MK-lane-QA"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MK-MK-2" label="명령 층 사례 골라짐&#xa;(MK-2)&#xa;넘김: 테스트 케이스 MD 커밋" step="(MK-2)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="테스트 케이스 MD 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MK-lane-QA"><mxGeometry x="566" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MK-MK-3" label="가짜 명령이 담은 갈래의 명령 층 사례와, 화면 사례 가운데 가짜로 누르는 줄을 지남&#xa;(MK-3)&#xa;넘김: 가짜 명령 커밋, 사례 결과" step="(MK-3)" owner="Lead Mod Tool Engineer" approve="없음" input="없음" handsOver="가짜 명령 커밋, 사례 결과" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MK-lane-LMTE"><mxGeometry x="766" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MK-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MK-lane-LMTE"><mxGeometry x="966" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MK-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MK-in" target="MK-MK-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MK-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MK-MK-1" target="MK-MK-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MK-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MK-MK-2" target="MK-MK-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MK-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MK-MK-3" target="MK-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MK-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Engineer&#xa;쓰는 때: MCP 기획서의 기능마다 명령과 관찰 칸을 정할 때&#xa;끝 판정: 계약(MK-1), 사례(MK-2), 가짜 명령이 담은 갈래의 명령 층 사례와, 화면 사례 가운데 가짜로 누르는 줄을 지남(MK-3). 보장하는 것: 그 버전의 가짜 명령이 골라진 명령 층 사례 가운데 가짜가 담은 갈래의 사례와, 받은 화면 사례 가운데 가짜로 누르는 줄을 지났다&#xa;정해 둔 자리: 목표 품질: 프로덕션이 바닥이다(Quality.md 「목표 품질을 고르는 기준」). 빠지는 때와 더하는 사용자 확인: 없음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="730.7" width="970" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MP" name="화면 기획 (MP)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MP-title" value="화면 기획 (MP)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1350" height="50" as="geometry"/></mxCell><mxCell id="MP-sig-in" value="입력&#xa;없음 · 계획 확정(E-1)에서 시작&#xa;에픽 워크플로우가 이 단위 워크플로우를 고르면 시작한다&#xa;게임 기획서 [공동 검토 통과] 버전의 그 기준 줄, 또는 Lead Designer가 그 기준을&#xa;답한 코멘트&#xa;게임 기획(GD) · 조건부(사람이 화면에서 판단하는 것의 기준이 게임의 뜻일 때). 게임 기획 인스턴스 하나를&#xa;통째로 돌리지 않는다&#xa;명령 계약 [정해짐] 버전&#xa;명령 계약(MK) · 선택(이미 있을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="630" height="265" as="geometry"/></mxCell><mxCell id="MP-sig-out" value="출력&#xa;화면 기획서 [공동 검토 통과] 버전&#xa;받는 곳: 화면 조립과 승인(MS) 필수, 컴포넌트 기획(MC) 선택(컴포넌트 목록 한 줄)이고 그 컴포넌트를 쓰는&#xa;화면이면 조건부(동작 표 줄과 가장 작은 창), 컴포넌트 개발(MD) 조건부(그 컴포넌트를 쓰는 화면이면 어느&#xa;상태를 강조하는지), 데이터 계약(DC) 조건부(데이터 스키마가 바뀔 때)&#xa;출력 요구: 컴포넌트 목록(아래 문단). 판단마다 사람이 그 화면에서 찾는 것과 빈도는 화면 기획서 「목적과&#xa;판단」이 적고, Lead Art Director의 시각 질의는 그것에 더하거나 다르게 보는 것만 검토 코멘트로 준다. 그&#xa;기획서가 사람 검수 전 QA 확인(MS-2)에 넘어간다(GRAVEN-2375 22160·22119, GRAVEN-2444)&#xa;화면 사례 [골라짐] 버전&#xa;받는 곳: 화면 조립과 승인(MS) 필수, 명령 계약(MK) 조건부(가짜 명령 위에서 화면을 승인할 때)&#xa;출력 요구: 사례가 데이터를 읽으면 그 데이터를 만든 레이어 묶음(월드들과 차례, Experience, 모드 목록)과&#xa;데이터 버전&#xa;명령 계약에 없는 값(공동 검토 MP-3에서 찾은 것)&#xa;받는 곳: AI 기능 기획(MA) 되돌림&#xa;출력 요구: 상태 이름 밖의 요구 없음" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="736" y="66" width="630" height="265" as="geometry"/></mxCell><mxCell id="MP-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MP-sig-in" target="MP-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MP-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="355" width="1382" height="122" as="geometry"/></mxCell></object><object id="MP-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="477" width="1382" height="122" as="geometry"/></mxCell></object><object id="MP-lane-LMTD" label="Lead Mod Tool Designer" lane="Lead Mod Tool Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="599" width="1382" height="130" as="geometry"/></mxCell></object><object id="MP-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="729" width="1382" height="122" as="geometry"/></mxCell></object><object id="MP-lane-LDM" label="Lead Data Modeler" lane="Lead Data Modeler"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="851" width="1382" height="122" as="geometry"/></mxCell></object><object id="MP-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="973" width="1382" height="122" as="geometry"/></mxCell></object><object id="MP-lane-ART" label="Lead Art Director" lane="Lead Art Director"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1095" width="1382" height="122" as="geometry"/></mxCell></object><object id="MP-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LMTD"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MP-MP-1" label="큰 그림 확인됨&#xa;(MP-1)&#xa;넘김: 사용자 확인 기록&#xa;빠지는 때: 사용자가 그 화면의 큰 그림을 확인한 코멘트가 있으면" step="(MP-1)" owner="사용자" approve="사용자" input="Lead Mod Tool Designer(한 장 자료)" handsOver="사용자 확인 기록" skipWhen="사용자가 그 화면의 큰 그림을 확인한 코멘트가 있으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-U"><mxGeometry x="366" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MP-rMP-1LMTD" label="입력 · 한 장 자료"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LMTD"><mxGeometry x="366" y="37" width="176" height="56" as="geometry"/></mxCell></object><object id="MP-MP-2" label="화면 기획서와 동작 표 작성됨&#xa;(MP-2)&#xa;넘김: 기획서 버전, 컴포넌트 목록, design 확인 기록, 검토 요청 코멘트" step="(MP-2)" owner="Lead Mod Tool Designer" approve="없음" input="Lead Designer(게임의 뜻)" handsOver="기획서 버전, 컴포넌트 목록, design 확인 기록, 검토 요청 코멘트" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LMTD"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MP-rMP-2LD" label="입력 · 게임의 뜻"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LD"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MP-MP-3" label="공동 검토됨&#xa;(MP-3)&#xa;넘김: 기획서 [공동 검토 통과] 버전, 담당마다 확인 기록" step="(MP-3)" owner="Lead Mod Tool Designer" approve="Lead Mod Tool Engineer, Lead QA Engineer" input="Lead Designer(화면이 게임의 뜻을 보일 때), Lead Art Director(화면에 새 요소가 들거나 모양이 바뀔 때. 시각 질의), Lead Data Modeler(데이터 스키마가 바뀔 때)" handsOver="기획서 [공동 검토 통과] 버전, 담당마다 확인 기록" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LMTD"><mxGeometry x="766" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MP-rMP-3LMTE" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LMTE"><mxGeometry x="766" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MP-rMP-3QA" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-QA"><mxGeometry x="766" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MP-rMP-3LD" label="입력 · 화면이 게임의 뜻을 보일 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LD"><mxGeometry x="766" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MP-rMP-3ART" label="입력 · 화면에 새 요소가 들거나 모양이 바뀔 때. 시각 질의"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-ART"><mxGeometry x="766" y="26" width="176" height="70" as="geometry"/></mxCell></object><object id="MP-rMP-3LDM" label="입력 · 데이터 스키마가 바뀔 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LDM"><mxGeometry x="766" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MP-MP-4" label="화면 사례 골라짐&#xa;(MP-4)&#xa;넘김: 테스트 케이스 MD 커밋" step="(MP-4)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="테스트 케이스 MD 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-QA"><mxGeometry x="966" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MP-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MP-lane-LMTD"><mxGeometry x="1166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MP-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MP-in" target="MP-MP-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MP-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MP-MP-1" target="MP-MP-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MP-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MP-MP-2" target="MP-MP-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MP-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MP-MP-3" target="MP-MP-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MP-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MP-MP-4" target="MP-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MP-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Designer&#xa;쓰는 때: 모딩 툴 화면을 새로 두거나 화면에서 사람이 판단하는 것을 바꿀 때. 질문 「화면에 새 요소가 들거나 화면의 모양이 바뀌는가」&#xa;끝 판정: 공동 검토(MP-3), 사례(MP-4). 보장하는 것: 승인 담당의 체크리스트 줄마다 그 버전의 기획서에 답이 있고 출력 요구가 채워졌으며, 화면 사례가 골라졌다&#xa;정해 둔 자리: 목표 품질: Quality.md 「목표 품질을 고르는 기준」대로 고른다. 방향만 보는 버릴 목업은 PoC 단위 워크플로우로 한다. 모딩 툴의 버리는 목업을 누가 어디에 만드는지는 버리는 목업이, 그 코드를 제품에 쓰는 조건은 모딩 툴 개발 방식이 정한다. 빠지는 때: 큰 그림 확인(MP-1)은 사용자가 그 화면의 큰 그림을 확인한 코멘트가 있으면 빠진다. 그 코멘트를 계획의 고른 선택에 적는다. 더하는 사용자 확인: 큰 그림 확인(MP-1)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="1233" width="1170" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MC" name="컴포넌트 기획 (MC)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MC-title" value="컴포넌트 기획 (MC)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1550" height="50" as="geometry"/></mxCell><mxCell id="MC-sig-in" value="입력&#xa;없음 · 계획 확정(E-1)에서 시작&#xa;에픽 워크플로우가 이 단위 워크플로우를 고르면 시작한다&#xa;화면 기획서 [공동 검토 통과] 버전의 컴포넌트 목록 한 줄&#xa;화면 기획(MP) · 선택. 없으면 아래 요구 기록의 줄이 입력이다&#xa;요구 기록 현재 버전([승인됨]이나 그 뒤 [정해짐])의 그 만들 것 줄&#xa;요구 확정(E-3) · 조건부(화면 기획서의 컴포넌트 목록 줄이 없을 때)&#xa;화면 기획서 [공동 검토 통과] 버전의 그 컴포넌트를 쓰는 동작 표 줄과 가장 작은 창&#xa;화면 기획(MP) · 조건부(그 컴포넌트를 쓰는 화면 기획이 있을 때. 컴포넌트 사례 MC-3이 읽는다)&#xa;컴포넌트 개발이 돌려준 줄(기획서에 답이 없는 것)&#xa;컴포넌트 개발(MD) · 되돌림&#xa;화면 마무리가 돌려준 줄(기획서에 답이 없는 줄이나 뜻을 바꿔야 하는 것)&#xa;화면 마무리(MF) · 되돌림&#xa;구조 결정 [정해짐] 버전(사용자가 확인했으면 [승인됨])&#xa;도구 구조(MT) · 조건부(그 에픽이 구조를 고쳤고, 그 구조를 검사하는 사례를 고를 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="730" height="301.4" as="geometry"/></mxCell><mxCell id="MC-sig-out" value="출력&#xa;컴포넌트 기획서 [공동 검토 통과] 버전. 그림 확인을 고른 것은 [승인됨] 버전(넣은 main 커밋)&#xa;받는 곳: 컴포넌트 개발(MD) 필수, 데이터 계약(DC) 조건부(데이터 스키마가 바뀔 때)&#xa;출력 요구: 상태 목록, 값의 규칙, 요소의 뜻(그림에 나오지 않는 것), 넘칠 때의 동작, 부분 이름과 상태 표식. 칸의 모양은&#xa;컴포넌트 기획서가 정한다&#xa;컴포넌트 사례 [골라짐] 버전&#xa;받는 곳: 컴포넌트 개발(MD) 필수(화면 조립에 쓰지 않는 컴포넌트), 화면 마무리(MF) 조건부(화면에 새로 만든 컴포넌트가 있을 때)&#xa;출력 요구: 사례가 데이터를 읽으면 그 데이터를 만든 레이어 묶음(월드들과 차례, Experience, 모드 목록)과 데이터 버전" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="836" y="66" width="730" height="301.4" as="geometry"/></mxCell><mxCell id="MC-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MC-sig-in" target="MC-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MC-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="391.4" width="1582" height="122" as="geometry"/></mxCell></object><object id="MC-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="513.4" width="1582" height="122" as="geometry"/></mxCell></object><object id="MC-lane-LMTD" label="Lead Mod Tool Designer" lane="Lead Mod Tool Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="635.4" width="1582" height="130" as="geometry"/></mxCell></object><object id="MC-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="765.4" width="1582" height="122" as="geometry"/></mxCell></object><object id="MC-lane-LDM" label="Lead Data Modeler" lane="Lead Data Modeler"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="887.4" width="1582" height="122" as="geometry"/></mxCell></object><object id="MC-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1009.4" width="1582" height="122" as="geometry"/></mxCell></object><object id="MC-lane-ART" label="Lead Art Director" lane="Lead Art Director"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1131.4" width="1582" height="122" as="geometry"/></mxCell></object><object id="MC-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LMTD"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MC-MC-1" label="컴포넌트 기획서 작성됨&#xa;(MC-1)&#xa;넘김: 기획서 버전, design 확인 기록, 검토 요청 코멘트" step="(MC-1)" owner="Lead Mod Tool Designer" approve="없음" input="없음" handsOver="기획서 버전, design 확인 기록, 검토 요청 코멘트" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LMTD"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MC-MC-2" label="공동 검토됨&#xa;(MC-2)&#xa;넘김: 기획서 [공동 검토 통과] 버전, 담당마다 확인 기록" step="(MC-2)" owner="Lead Mod Tool Designer" approve="Lead Mod Tool Engineer, Lead QA Engineer" input="Lead Art Director(화면에 새 요소가 들거나 모양이 바뀔 때), Lead Designer(컴포넌트 기획서가 게임 기획서의 줄을 인용할 때), Lead Data Modeler(데이터 스키마가 바뀔 때)" handsOver="기획서 [공동 검토 통과] 버전, 담당마다 확인 기록" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LMTD"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MC-rMC-2LMTE" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LMTE"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MC-rMC-2QA" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-QA"><mxGeometry x="566" y="33.000000000000114" width="176" height="56" as="geometry"/></mxCell></object><object id="MC-rMC-2ART" label="입력 · 화면에 새 요소가 들거나 모양이 바뀔 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-ART"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MC-rMC-2LD" label="입력 · 컴포넌트 기획서가 게임 기획서의 줄을 인용할 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LD"><mxGeometry x="566" y="26" width="176" height="70" as="geometry"/></mxCell></object><object id="MC-rMC-2LDM" label="입력 · 데이터 스키마가 바뀔 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LDM"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MC-MC-3" label="컴포넌트 사례 골라짐&#xa;(MC-3)&#xa;넘김: 테스트 케이스 MD 커밋" step="(MC-3)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="테스트 케이스 MD 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-QA"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MC-MC-4" label="사용자가 그림을 확인함&#xa;(MC-4)&#xa;넘김: 판정과 까닭&#xa;빠지는 때: 계획 때 고르지 않았으면" step="(MC-4)" owner="사용자" approve="사용자" input="Lead Mod Tool Designer(공동 검토를 통과한 버전의 그림), Lead Art Director(그림에 모양을 입힐 때. 판정이 고칠 모양 줄을 정하면 고친 버전을 다시 본다)" handsOver="판정과 까닭" skipWhen="계획 때 고르지 않았으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-U"><mxGeometry x="966" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MC-rMC-4LMTD" label="입력 · 공동 검토를 통과한 버전의 그림"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LMTD"><mxGeometry x="966" y="37" width="176" height="56" as="geometry"/></mxCell></object><object id="MC-rMC-4ART" label="입력 · 그림에 모양을 입힐 때. 판정이 고칠 모양 줄을 정하면 고친 버전을 다시 본다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-ART"><mxGeometry x="966" y="18" width="176" height="86" as="geometry"/></mxCell></object><object id="MC-MC-5" label="컴포넌트 기획서 넣음&#xa;(MC-5)&#xa;넘김: 공동 검토 통과 버전(그림 확인을 고른 것은 승인 버전)을 Docs/Spec/Design/ModTool 아래에 넣은 main 커밋" step="(MC-5)" owner="Lead Mod Tool Designer" approve="없음" input="없음" handsOver="공동 검토 통과 버전(그림 확인을 고른 것은 승인 버전)을 Docs/Spec/Design/ModTool 아래에 넣은 main 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LMTD"><mxGeometry x="1166" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MC-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MC-lane-LMTD"><mxGeometry x="1366" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MC-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MC-in" target="MC-MC-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MC-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MC-MC-1" target="MC-MC-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MC-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MC-MC-2" target="MC-MC-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MC-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MC-MC-3" target="MC-MC-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MC-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MC-MC-4" target="MC-MC-5"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MC-e5" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MC-MC-5" target="MC-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MC-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Designer&#xa;쓰는 때: 컴포넌트를 새로 두거나 동작·상태를 바꿀 때. 대상마다 한 번. 질문 「화면에 새 요소가 들거나 화면의 모양이 바뀌는가」&#xa;끝 판정: 공동 검토(MC-2), 사례(MC-3), 고른 때는 그림 확인(MC-4), 기획서 넣음(MC-5). 보장하는 것: 승인 담당의 체크리스트 줄마다 그 버전의 기획서에 답이 있고 출력 요구가 채워졌으며, 컴포넌트 사례가 골라졌다. 고른 때는 사용자가 그 버전의 그림을 보고 맞다고 봤다. 그 버전이 main에 들어갔다&#xa;정해 둔 자리: 목표 품질: Quality.md 「목표 품질을 고르는 기준」대로 고른다. 더하는 사용자 확인: 그림 확인(MC-4, 계획 때 고른 것). 빠지는 때: 그림 확인은 고르지 않았으면 빠진다" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="1269.4" width="1370" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MD" name="컴포넌트 개발 (MD)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MD-title" value="컴포넌트 개발 (MD)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1750" height="50" as="geometry"/></mxCell><mxCell id="MD-sig-in" value="입력&#xa;컴포넌트 기획서 [공동 검토 통과] 버전(그림 확인을 고른 것은 [승인됨] 버전)과 컴포넌트 사례 [골라짐] 버전(사례는&#xa;화면 조립에 쓰지 않는 컴포넌트만)&#xa;컴포넌트 기획(MC) · 필수&#xa;맞춘 라이브러리 [QA 통과] 버전&#xa;Unreal 맞춤(MU), 또는 이미 있는 버전 · 조건부(맞춘 라이브러리를 부르는 컴포넌트)&#xa;그 라이브러리의 출력 형을 적은 기술 계약 [정해짐] 버전&#xa;계획 확정(E-1). 그 라이브러리를 만드는 Lead가 계획 확정 뒤 첫 하위로 적는다. 새 버전은 그 계약을 받는 인스턴스가 올린다(위 「단위 워크플로우&#xa;사이를 잇는 규칙」) · 조건부(라이브러리의 출력 형만 받는 컴포넌트. 맞춘 라이브러리 대신 받는다)&#xa;화면 기획서 [공동 검토 통과] 버전의 그 컴포넌트에서 강조할 상태&#xa;화면 기획(MP) · 조건부(그 컴포넌트를 쓰는 화면 기획이 있을 때)&#xa;데이터 계약 [정해짐] 버전과 스키마 문서 커밋&#xa;데이터 계약(DC) · 조건부(바뀐 표를 읽거나 쓸 때)&#xa;화면 조립과 승인이 돌려준 컴포넌트 결함&#xa;화면 조립과 승인(MS) · 되돌림&#xa;구조 결정 [정해짐] 버전(사용자가 확인했으면 [승인됨])&#xa;도구 구조(MT) · 조건부(그 에픽이 구조를 고쳤을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="830" height="333.9" as="geometry"/></mxCell><mxCell id="MD-sig-out" value="출력&#xa;컴포넌트 [넣음] 버전(동작과 모양을 함께 넣은 main 커밋)&#xa;받는 곳: 화면 조립과 승인(MS) 필수(화면이 쓰는 새 컴포넌트 모두. 화면 마무리가 되돌린 컴포넌트는 빼고), 화면 마무리(MF) 되돌림(화면 마무리가&#xa;컴포넌트 기획으로 되돌린 컴포넌트), 데이터 계약(DC) 조건부(줄이기 DC-2 전에 새 모양으로 옮긴 컴포넌트)&#xa;출력 요구: 부분 이름과 상태 표식이 컴포넌트 기획서의 상태 목록 글자와 같고, 스타일-3 검사를 지났고 상태마다의 Storybook 캡처가 있다&#xa;컴포넌트 [QA 통과] 버전. Storybook 확인을 고른 것은 [승인됨]&#xa;받는 곳: 화면 조립과 승인(MS)의 「이미 있는 버전」(뒤 에픽), 에픽 끝(E-2)의 인수(화면 조립에 쓰지 않는 컴포넌트)&#xa;출력 요구: 상태 이름 밖의 요구 없음&#xa;컴포넌트 기획서에 답이 없는 줄(합쳐 확인 MD-4나 컴포넌트 QA MD-5에서 찾은 것)&#xa;받는 곳: 컴포넌트 기획(MC) 되돌림&#xa;출력 요구: 상태 이름 밖의 요구 없음" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="936" y="66" width="830" height="333.9" as="geometry"/></mxCell><mxCell id="MD-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MD-sig-in" target="MD-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MD-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="423.9" width="1782" height="122" as="geometry"/></mxCell></object><object id="MD-lane-LMTD" label="Lead Mod Tool Designer" lane="Lead Mod Tool Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="545.9" width="1782" height="122" as="geometry"/></mxCell></object><object id="MD-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="667.9" width="1782" height="130" as="geometry"/></mxCell></object><object id="MD-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="797.9" width="1782" height="122" as="geometry"/></mxCell></object><object id="MD-lane-ART" label="Lead Art Director" lane="Lead Art Director"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="919.9" width="1782" height="122" as="geometry"/></mxCell></object><object id="MD-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTE"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MD-MD-1" label="기준 값 정해짐&#xa;(MD-1)&#xa;넘김: 기준 값 파일 커밋&#xa;빠지는 때: 기준 값 파일에 더할 이름이 없으면" step="(MD-1)" owner="Lead Art Director" approve="없음" input="Lead Mod Tool Designer(상태 목록)" handsOver="기준 값 파일 커밋" skipWhen="기준 값 파일에 더할 이름이 없으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-ART"><mxGeometry x="366" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MD-rMD-1LMTD" label="입력 · 상태 목록"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTD"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MD-MD-2" label="동작 만들어짐&#xa;(MD-2)&#xa;넘김: 컴포넌트 코드와 Storybook 상태 이야기. 화면 조립에 쓰지 않는 컴포넌트는 컴포넌트 사례 코드도" step="(MD-2)" owner="Lead Mod Tool Engineer" approve="없음" input="Lead Art Director(기준 값 정해짐(MD-1)이 main에 넣은 새 이름. 그 컴포넌트만 쓰는 그림 안 요소 이름은 모양 만들어짐(MD-3)이 모양 파일에 둔 이름과 그리기 조건. 둘 다 없으면 없음), Lead QA Engineer(컴포넌트 손잡이의 이름과 부르는 모양. 도구 QA 프로세스의 「부품 손잡이」)" handsOver="컴포넌트 코드와 Storybook 상태 이야기. 화면 조립에 쓰지 않는 컴포넌트는 컴포넌트 사례 코드도" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTE"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MD-rMD-2ART" label="입력 · 기준 값 정해짐(MD-1)이 main에 넣은 새 이름. 그 컴포넌트만 쓰는 그림 안 요소 이름은 모양 만들어짐(MD-3)이 모양 파일에 둔 이름과 그리기 조건. 둘 다 없으면 없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-ART"><mxGeometry x="566" y="6" width="176" height="110" as="geometry"/></mxCell></object><object id="MD-rMD-2QA" label="입력 · 컴포넌트 손잡이의 이름과 부르는 모양. 도구 QA 프로세스의 「부품 손잡이」"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-QA"><mxGeometry x="566" y="18" width="176" height="86" as="geometry"/></mxCell></object><object id="MD-MD-3" label="모양 만들어짐&#xa;(MD-3)&#xa;넘김: 모양 파일" step="(MD-3)" owner="Lead Art Director" approve="없음" input="Lead Mod Tool Designer(컴포넌트 기획서의 부분 이름과 상태 표식. 동작 하위와 모양 하위 본문에 같은 글자로 먼저 적는다)" handsOver="모양 파일" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-ART"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MD-rMD-3LMTD" label="입력 · 컴포넌트 기획서의 부분 이름과 상태 표식. 동작 하위와 모양 하위 본문에 같은 글자로 먼저 적는다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTD"><mxGeometry x="766" y="10" width="176" height="102" as="geometry"/></mxCell></object><object id="MD-MD-4" label="동작과 모양을 합쳐 확인하고 함께 넣음&#xa;(MD-4)&#xa;넘김: 컴포넌트 [넣음] 버전(함께 넣은 main 커밋), 스타일-3 검사 결과, 상태마다의 Storybook 캡처" step="(MD-4)" owner="Lead Mod Tool Engineer" approve="Lead Mod Tool Designer(기획서의 판단과 기준대로 보이는지)" input="Lead Art Director(모양)" handsOver="컴포넌트 [넣음] 버전(함께 넣은 main 커밋), 스타일-3 검사 결과, 상태마다의 Storybook 캡처" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTE"><mxGeometry x="966" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MD-rMD-4LMTD" label="승인 · 기획서의 판단과 기준대로 보이는지"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTD"><mxGeometry x="966" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MD-rMD-4ART" label="입력 · 모양"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-ART"><mxGeometry x="966" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MD-MD-5" label="컴포넌트 QA 판정됨&#xa;(MD-5)&#xa;넘김: QA 판정 코멘트, 컴포넌트 사례 통과&#xa;빠지는 때: 화면 조립에 쓰는 컴포넌트면" step="(MD-5)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="QA 판정 코멘트, 컴포넌트 사례 통과" skipWhen="화면 조립에 쓰는 컴포넌트면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-QA"><mxGeometry x="1166" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MD-MD-6" label="사용자가 Storybook에서 확인함&#xa;(MD-6)&#xa;넘김: 판정과 까닭(아래 「사람이 확인한 예시」)&#xa;빠지는 때: 계획 때 고르지 않았으면. 화면 조립에 쓰는 컴포넌트는 고르지 않는다" step="(MD-6)" owner="사용자" approve="사용자" input="Lead Mod Tool Designer(지난 기록에서 같은 종류를 확인한 자리)" handsOver="판정과 까닭(아래 「사람이 확인한 예시」)" skipWhen="계획 때 고르지 않았으면. 화면 조립에 쓰는 컴포넌트는 고르지 않는다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-U"><mxGeometry x="1366" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MD-rMD-6LMTD" label="입력 · 지난 기록에서 같은 종류를 확인한 자리"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTD"><mxGeometry x="1366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MD-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MD-lane-LMTE"><mxGeometry x="1566" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MD-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MD-in" target="MD-MD-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MD-MD-1" target="MD-MD-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MD-MD-1" target="MD-MD-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MD-MD-2" target="MD-MD-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MD-MD-3" target="MD-MD-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e5" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MD-MD-4" target="MD-MD-5"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e6" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MD-MD-5" target="MD-MD-6"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e7" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MD-MD-4" target="MD-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e8" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MD-MD-5" target="MD-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MD-e9" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MD-MD-6" target="MD-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MD-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Engineer&#xa;쓰는 때: 공동 검토를 통과한 컴포넌트를 만들 때. 대상마다 한 번&#xa;시작 조건: 필수 입력과 조건이 맞는 조건부 입력이 모두 그 상태의 버전으로 있다. 라이브러리의 출력 형만 받는 컴포넌트는 그 형을 적은 기술 계약 [정해짐] 버전이 있으면 Unreal 맞춤을 기다리지 않는다&#xa;끝 판정: 함께 넣음(MD-4). 화면 조립에 쓰지 않는 컴포넌트는 컴포넌트 QA(MD-5)와 Storybook 확인(MD-6, 고른 것)도 한다. 보장하는 것: 그 버전의 부분 이름과 상태 표식이 상태 목록 글자와 같고, 스타일-3 검사를 지났고 상태마다의 Storybook 캡처가 있다. 화면 조립에 쓰지 않는 컴포넌트는 골라진 컴포넌트 사례도 지났고, 고른 것은 사용자가 상태마다 눌러 보고 맞다고 봤다&#xa;정해 둔 자리: 목표 품질: 그 컴포넌트의 컴포넌트 기획과 같다. 컴포넌트는 처음부터 제품 코드로 만든다. 빠지는 때: 기준 값(MD-1)은 기준 값 파일에 더할 이름이 없으면 빠진다. 컴포넌트 QA(MD-5)는 화면 조립에 쓰는 컴포넌트면 빠지고, 그 사례 코드와 판정은 화면 마무리(MF-1, MF-4)가 맡는다. 더하는 사용자 확인: Storybook 확인(MD-6). 기본으로 두지 않고 계획 때 계획의 고른 선택 칸에서 고른다. 그 에픽에서 화면 조립에 쓰지 않는 컴포넌트(예: 3D 뷰어)에서만 고를 수 있다. 화면 조립에 쓰는 컴포넌트는 따로 승인받지 않고 화면 승인(MS-3)에서 본다(까닭은 위 「화면 기획」). 고를 때는 틀렸을 때 버리는 일이 많은 것, 곧 뒤 에픽의 여러 화면이 함께 쓸 바탕 컴포넌트를 고른다. 사람은 한 명이라, 틀리면 많은 일을 버리게 되는 것만 사용자 확인으로 앞에 둔다(같은 기능 묶음 차례의 「사용자 확인은 묶음마다 셋까지다」 문단, GRAVEN-2213 20811). 여러 화면이 함께 쓰는 셸과 바탕 다섯을 화면 일 앞에 정해 사용자 승인을 받는 계획을 사용자가 받았다(GRAVEN-2105 20214 3절 (나), 20216)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="1057.9" width="1570" height="188" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MS" name="화면 조립과 승인 (MS)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MS-title" value="화면 조립과 승인 (MS)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1350" height="50" as="geometry"/></mxCell><mxCell id="MS-sig-in" value="입력&#xa;화면 기획서 [공동 검토 통과] 버전과 화면 사례 [골라짐] 버전&#xa;화면 기획(MP) · 필수&#xa;화면이 쓰는 컴포넌트 모두. 새로 만든 것은 [넣음] 버전, 이미 있는 것은 [QA 통과] 버전&#xa;새로 만든 것은 컴포넌트 개발(MD). 이미 있는 것은 이미 있는 버전(앞 에픽의 컴포넌트 개발(MD)이나 화면&#xa;마무리(MF)가 낸 것) · 필수&#xa;명령: 가짜 명령 [사례 통과] 버전 또는 진짜 명령 [QA 통과] 버전&#xa;명령 계약(MK) 또는 AI 기능 구현(MI) · 필수(둘 가운데 하나)&#xa;구조 결정 [정해짐] 버전(사용자가 확인했으면 [승인됨])&#xa;도구 구조(MT) · 조건부(그 에픽이 구조를 고쳤을 때)&#xa;화면 마무리가 돌려준 판단 바뀜(컴포넌트 기획으로 되돌린 고침이 승인한 화면의 판단을&#xa;바꾼 것)&#xa;화면 마무리(MF) · 되돌림" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="630" height="330" as="geometry"/></mxCell><mxCell id="MS-sig-out" value="출력&#xa;화면 [승인됨] 버전&#xa;받는 곳: 화면 마무리(MF) 필수&#xa;출력 요구: 상태 이름 밖의 요구 없음&#xa;화면 스펙과 동작 표 [승인됨] 커밋(화면 스펙 넣음 MS-4)&#xa;받는 곳: 화면 마무리(MF) 필수&#xa;출력 요구: 사례 MD 머리의 「옮긴 원본의 판」이 가리킬 커밋(도구 QA 프로세스 「11 뒤」)&#xa;승인에서 바뀐 컴포넌트 목록&#xa;받는 곳: 화면 마무리(MF) 필수(승인 뒤 고침 MF-1이 고칠 컴포넌트)&#xa;출력 요구: 상태 이름 밖의 요구 없음&#xa;판정 예시&#xa;받는 곳: 「사람이 확인한 예시」 자리&#xa;출력 요구: 무엇과 나란히 놓고 보았는지, 판정(맞다·다르다), 그 판정을 가른 까닭을 담는다(Quality.md&#xa;「경험의 품질」, 아래 「사람이 확인한 예시」)&#xa;화면에서 찾은 컴포넌트 결함(화면 조립 MS-1이나 사람 검수 전 QA 확인 MS-2에서 찾은&#xa;것)&#xa;받는 곳: 컴포넌트 개발(MD) 되돌림&#xa;출력 요구: 상태 이름 밖의 요구 없음" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="736" y="66" width="630" height="330" as="geometry"/></mxCell><mxCell id="MS-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MS-sig-in" target="MS-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MS-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="420" width="1382" height="122" as="geometry"/></mxCell></object><object id="MS-lane-LMTD" label="Lead Mod Tool Designer" lane="Lead Mod Tool Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="542" width="1382" height="130" as="geometry"/></mxCell></object><object id="MS-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="672" width="1382" height="122" as="geometry"/></mxCell></object><object id="MS-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="794" width="1382" height="122" as="geometry"/></mxCell></object><object id="MS-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-LMTD"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MS-MS-1" label="화면 조립됨&#xa;(MS-1)&#xa;넘김: 모양이 든 컴포넌트로 만든 조립 커밋" step="(MS-1)" owner="Lead Mod Tool Engineer" approve="Lead Mod Tool Designer(기획서의 판단과 기준대로 보이는지)" input="없음" handsOver="모양이 든 컴포넌트로 만든 조립 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-LMTE"><mxGeometry x="366" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MS-rMS-1LMTD" label="승인 · 기획서의 판단과 기준대로 보이는지"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-LMTD"><mxGeometry x="366" y="37" width="176" height="56" as="geometry"/></mxCell></object><object id="MS-MS-2" label="사람 검수 전 QA 확인 끝남&#xa;(MS-2)&#xa;넘김: 검토 코멘트, 바뀐 사례 커밋" step="(MS-2)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="검토 코멘트, 바뀐 사례 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-QA"><mxGeometry x="566" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MS-MS-3" label="화면 승인됨&#xa;(MS-3)&#xa;넘김: 승인 버전, 승인에서 바뀐 컴포넌트 목록, 판정과 까닭" step="(MS-3)" owner="사용자" approve="사용자" input="Lead Mod Tool Designer(사용자 검수를 올릴 때의 다섯)" handsOver="승인 버전, 승인에서 바뀐 컴포넌트 목록, 판정과 까닭" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-U"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MS-rMS-3LMTD" label="입력 · 사용자 검수를 올릴 때의 다섯"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-LMTD"><mxGeometry x="766" y="37" width="176" height="56" as="geometry"/></mxCell></object><object id="MS-MS-4" label="화면 스펙 넣음&#xa;(MS-4)&#xa;넘김: 승인한 화면 스펙과 동작 표를 Docs/Spec에 넣은 main 커밋" step="(MS-4)" owner="Lead Mod Tool Designer" approve="없음" input="없음" handsOver="승인한 화면 스펙과 동작 표를 Docs/Spec에 넣은 main 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-LMTD"><mxGeometry x="966" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MS-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MS-lane-LMTD"><mxGeometry x="1166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MS-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MS-in" target="MS-MS-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MS-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MS-MS-1" target="MS-MS-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MS-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MS-MS-2" target="MS-MS-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MS-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MS-MS-3" target="MS-MS-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MS-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MS-MS-3" target="MS-MS-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MS-e5" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MS-MS-4" target="MS-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MS-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;위로 돌아가는 화살표: 화면 승인에서 사용자가 바꾼 줄은 사람 검수 전 QA 확인이 다시 본다. 승인에서 바뀐 컴포넌트는 화면 마무리의 승인 뒤 고침에서 고친다.&#xa;맡은 Lead: Lead Mod Tool Designer&#xa;쓰는 때: 화면이 쓰는 컴포넌트가 모두 있고 사람이 화면을 승인할 때&#xa;시작 조건: 계획의 갈라짐과 모임 칸에 적은 모이는 조건(화면이 쓰는 컴포넌트 모두)이 채워졌다&#xa;끝 판정: 화면 승인(MS-3). 보장하는 것: 사용자가 그 버전의 화면을 보고 맞다고 봤다&#xa;정해 둔 자리: 목표 품질: 그 화면의 화면 기획과 같다. 더하는 사용자 확인: 화면 승인(MS-3)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="932" width="1170" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MF" name="화면 마무리 (MF)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MF-title" value="화면 마무리 (MF)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1550" height="50" as="geometry"/></mxCell><mxCell id="MF-sig-in" value="입력&#xa;화면 [승인됨] 버전과 승인에서 바뀐 컴포넌트 목록&#xa;화면 조립과 승인(MS) · 필수&#xa;화면 스펙과 동작 표 [승인됨] 커밋&#xa;화면 조립과 승인(MS) · 필수&#xa;컴포넌트 사례 [골라짐] 버전&#xa;컴포넌트 기획(MC) · 조건부(화면에 새로 만든 컴포넌트가 있을 때)&#xa;컴포넌트 기획으로 되돌렸다가 다시 만든 컴포넌트 [넣음] 버전&#xa;컴포넌트 개발(MD) · 되돌림(화면 마무리가 컴포넌트 기획으로 되돌린 컴포넌트)&#xa;진짜 명령 [QA 통과] 버전&#xa;AI 기능 구현(MI) · 조건부(가짜 명령으로 승인했을 때)&#xa;구조 결정 [정해짐] 버전(사용자가 확인했으면 [승인됨])&#xa;도구 구조(MT) · 조건부(그 에픽이 구조를 고쳤을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="730" height="263.7" as="geometry"/></mxCell><mxCell id="MF-sig-out" value="출력&#xa;제품 화면 [QA 통과] 버전&#xa;받는 곳: 에픽 끝(E-2)의 인수&#xa;출력 요구: 상태 이름 밖의 요구 없음&#xa;새로 만든 컴포넌트 [QA 통과] 버전(독립 QA MF-4가 그 컴포넌트의 사례 통과를 본 버전)&#xa;받는 곳: 화면 조립과 승인(MS)의 「이미 있는 버전」(뒤 에픽)&#xa;출력 요구: 상태 이름 밖의 요구 없음&#xa;기획서에 답이 없는 줄이나 기획서의 뜻을 바꿔야 하는 결함(승인 뒤 고침 MF-1의 컴포넌트 사례에서&#xa;찾은 것)&#xa;받는 곳: 컴포넌트 기획(MC) 되돌림&#xa;출력 요구: 상태 이름 밖의 요구 없음&#xa;승인한 화면의 판단을 바꾸는 컴포넌트 고침(컴포넌트 기획으로 되돌린 고침이 판단을 바꿀 때)&#xa;받는 곳: 화면 조립과 승인(MS) 되돌림&#xa;출력 요구: 바뀐 판단과 그 판단이 쓰는 컴포넌트" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="836" y="66" width="730" height="263.7" as="geometry"/></mxCell><mxCell id="MF-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MF-sig-in" target="MF-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MF-lane-LMTD" label="Lead Mod Tool Designer" lane="Lead Mod Tool Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="353.7" width="1582" height="122" as="geometry"/></mxCell></object><object id="MF-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="475.7" width="1582" height="130" as="geometry"/></mxCell></object><object id="MF-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="605.7" width="1582" height="122" as="geometry"/></mxCell></object><object id="MF-lane-ART" label="Lead Art Director" lane="Lead Art Director"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="727.7" width="1582" height="122" as="geometry"/></mxCell></object><object id="MF-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-LMTE"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MF-MF-1" label="승인 뒤 고침과 컴포넌트 사례 끝남&#xa;(MF-1)&#xa;넘김: 고침 커밋, 컴포넌트 사례 코드와 실행 기록&#xa;빠지는 때: 새 컴포넌트와 승인에서 바뀐 곳이 없으면" step="(MF-1)" owner="Lead Mod Tool Engineer" approve="없음" input="없음" handsOver="고침 커밋, 컴포넌트 사례 코드와 실행 기록" skipWhen="새 컴포넌트와 승인에서 바뀐 곳이 없으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-LMTE"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MF-MF-5" label="승인 뒤 모양 고쳐짐&#xa;(MF-5)&#xa;넘김: 승인에서 바뀐 모양과, 컴포넌트 사례(MF-1)가 찾은 모양 결함을 고친 모양 파일 커밋&#xa;빠지는 때: 승인에서 모양이 바뀌지 않았고 승인 뒤 고침(MF-1)이 모양 결함을 찾지 않았으면" step="(MF-5)" owner="Lead Art Director" approve="없음" input="없음" handsOver="승인에서 바뀐 모양과, 컴포넌트 사례(MF-1)가 찾은 모양 결함을 고친 모양 파일 커밋" skipWhen="승인에서 모양이 바뀌지 않았고 승인 뒤 고침(MF-1)이 모양 결함을 찾지 않았으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-ART"><mxGeometry x="366" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MF-MF-2" label="승인 버전과 대조됨&#xa;(MF-2)&#xa;넘김: 승인 버전과 같은 조립 커밋, 컴포넌트 사례를 모두 지난 실행 기록" step="(MF-2)" owner="Lead Mod Tool Engineer" approve="Lead Mod Tool Designer(승인 버전과 같은지)" input="없음" handsOver="승인 버전과 같은 조립 커밋, 컴포넌트 사례를 모두 지난 실행 기록" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-LMTE"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MF-rMF-2LMTD" label="승인 · 승인 버전과 같은지"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-LMTD"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MF-MF-3" label="진짜 명령으로 바꿔 끼움&#xa;(MF-3)&#xa;넘김: 주입 자리 커밋&#xa;빠지는 때: 가짜 명령을 쓰지 않았으면. 계획이 그 묶음의 다른 인스턴스에 맡겼으면" step="(MF-3)" owner="Lead Mod Tool Engineer" approve="없음" input="없음" handsOver="주입 자리 커밋" skipWhen="가짜 명령을 쓰지 않았으면. 계획이 그 묶음의 다른 인스턴스에 맡겼으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-LMTE"><mxGeometry x="766" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MF-MF-6" label="스타일 판정 실행됨&#xa;(MF-6)&#xa;넘김: 기준 값 셋만 바꾼 커밋과 스타일 판정마다의 답. 아니오가 있으면 그 커밋을 되돌린 커밋&#xa;빠지는 때: 계획이 그 묶음의 다른 인스턴스에 맡겼으면" step="(MF-6)" owner="Lead Art Director" approve="없음" input="없음" handsOver="기준 값 셋만 바꾼 커밋과 스타일 판정마다의 답. 아니오가 있으면 그 커밋을 되돌린 커밋" skipWhen="계획이 그 묶음의 다른 인스턴스에 맡겼으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-ART"><mxGeometry x="966" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MF-MF-4" label="독립 QA 판정됨&#xa;(MF-4)&#xa;넘김: QA 판정 코멘트와 원증거, qa 확인 기록 「QA에서 확인했나」" step="(MF-4)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="QA 판정 코멘트와 원증거, qa 확인 기록 「QA에서 확인했나」" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-QA"><mxGeometry x="1166" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MF-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MF-lane-LMTE"><mxGeometry x="1366" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MF-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MF-in" target="MF-MF-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MF-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MF-in" target="MF-MF-5"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MF-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MF-MF-1" target="MF-MF-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MF-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MF-MF-5" target="MF-MF-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MF-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MF-MF-2" target="MF-MF-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MF-e5" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MF-MF-3" target="MF-MF-6"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MF-e6" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MF-MF-6" target="MF-MF-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MF-e7" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MF-MF-4" target="MF-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MF-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Engineer&#xa;쓰는 때: 승인된 화면을 제품 코드로 끝낼 때&#xa;끝 판정: 독립 QA(MF-4). 보장하는 것: 그 버전이 골라진 화면 사례를 지났고, 새로 만든 컴포넌트마다 골라진 컴포넌트 사례가 승인 뒤 고침(MF-1)이 닫히기 전에 모두 지났다&#xa;정해 둔 자리: 목표 품질: 그 화면의 화면 기획과 같다. 빠지는 때: 승인 뒤 고침(MF-1)은 새 컴포넌트와 승인에서 바뀐 곳이 없으면, 승인 뒤 모양 고침(MF-5)은 승인에서 모양이 바뀌지 않았고 승인 뒤 고침이 모양 결함을 찾지 않았으면, 바꿔 끼움(MF-3)은 가짜 명령을 쓰지 않았으면. 바꿔 끼움(MF-3)과 스타일 판정 실행(MF-6)은 묶음마다 한 번이라 계획이 그 묶음의 다른 인스턴스에 맡겼으면 빠진다. 더하는 사용자 확인: 없음. 승인 버전에 맞추는 고침은 다시 묻지 않는다" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="865.7" width="1370" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MI" name="AI 기능 구현 (MI)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MI-title" value="AI 기능 구현 (MI)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="MI-sig-in" value="입력&#xa;명령 계약 [정해짐] 버전과 명령 층 사례 [골라짐] 버전&#xa;명령 계약(MK) · 필수&#xa;가짜 명령 [사례 통과] 버전&#xa;명령 계약(MK) · 조건부(가짜 명령이 있을 때)&#xa;맞춘 라이브러리 [QA 통과] 버전&#xa;Unreal 맞춤(MU) · 조건부(계산이 게임과 같아야 할 때)&#xa;구조 결정 [정해짐] 버전(사용자가 확인했으면 [승인됨])&#xa;도구 구조(MT) · 조건부(그 에픽이 구조를 고쳤을 때)&#xa;데이터 계약 [정해짐] 버전과 스키마 문서 커밋&#xa;데이터 계약(DC) · 조건부(바뀐 표를 읽거나 쓸 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="226" as="geometry"/></mxCell><mxCell id="MI-sig-out" value="출력&#xa;진짜 명령·계산 모듈 [QA 통과] 버전&#xa;받는 곳: 화면 조립과 승인(MS) 필수(가짜 명령과 둘 가운데 하나), 화면 마무리(MF)&#xa;조건부(가짜 명령으로 승인했을 때), 데이터 계약(DC) 조건부(줄이기 DC-2 전에 새 모양으로&#xa;옮긴 것)&#xa;출력 요구: 상태 이름 밖의 요구 없음" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="226" as="geometry"/></mxCell><mxCell id="MI-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MI-sig-in" target="MI-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MI-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="316" width="1182" height="130" as="geometry"/></mxCell></object><object id="MI-lane-LUE" label="Lead Unreal Engineer" lane="Lead Unreal Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="446" width="1182" height="122" as="geometry"/></mxCell></object><object id="MI-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="568" width="1182" height="122" as="geometry"/></mxCell></object><object id="MI-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MI-lane-LMTE"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MI-MI-1" label="진짜 명령과 계산 모듈 만들어짐&#xa;(MI-1)&#xa;넘김: 명령·계산 커밋, 명령 층 사례 통과" step="(MI-1)" owner="Lead Mod Tool Engineer" approve="없음" input="Lead Unreal Engineer(게임 근거)" handsOver="명령·계산 커밋, 명령 층 사례 통과" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MI-lane-LMTE"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MI-rMI-1LUE" label="입력 · 게임 근거"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MI-lane-LUE"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MI-MI-2" label="가짜가 담은 갈래의 사례가 가짜와 진짜에서 같게 나옴&#xa;(MI-2)&#xa;넘김: 두 쪽의 사례 결과&#xa;빠지는 때: 가짜 명령이 없으면" step="(MI-2)" owner="Lead Mod Tool Engineer" approve="없음" input="없음" handsOver="두 쪽의 사례 결과" skipWhen="가짜 명령이 없으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MI-lane-LMTE"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MI-MI-3" label="독립 QA 판정됨&#xa;(MI-3)&#xa;넘김: QA 판정 코멘트와 원증거" step="(MI-3)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="QA 판정 코멘트와 원증거" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="MI-lane-QA"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MI-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MI-lane-LMTE"><mxGeometry x="966" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="MI-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MI-in" target="MI-MI-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MI-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="MI-MI-1" target="MI-MI-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MI-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MI-MI-2" target="MI-MI-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MI-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MI-MI-3" target="MI-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MI-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Engineer&#xa;쓰는 때: 명령 계약대로 진짜 명령과 계산 모듈을 만들 때. 질문 「사람이나 AI가 모딩 툴에서 하는 일이 바뀌는가」&#xa;끝 판정: 독립 QA(MI-3). 보장하는 것: 그 버전이 골라진 명령 층 사례를 지났고, 가짜가 담은 갈래가 가짜와 진짜에서 같게 나왔다&#xa;정해 둔 자리: 목표 품질: 프로덕션이 바닥이다(Quality.md 「목표 품질을 고르는 기준」). 빠지는 때: 가짜와 진짜 대조(MI-2)는 가짜 명령이 없으면. 더하는 사용자 확인: 없음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="706" width="970" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="MU" name="Unreal 맞춤 (MU)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="MU-title" value="Unreal 맞춤 (MU)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1350" height="50" as="geometry"/></mxCell><mxCell id="MU-sig-in" value="입력&#xa;요구 기록 현재 버전([승인됨]이나 그 뒤 [정해짐])의 그 출력 줄&#xa;요구 확정(E-3) · 필수&#xa;부른 Lead들의 계획 답&#xa;계획 확정(E-1) · 필수&#xa;구조 결정 [정해짐] 버전(사용자가 확인했으면 [승인됨])&#xa;도구 구조(MT) · 조건부(그 에픽이 구조를 고쳤을 때)&#xa;데이터 계약 [정해짐] 버전과 스키마 문서 커밋&#xa;데이터 계약(DC) · 조건부(바뀐 표를 읽거나 쓸 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="630" height="288.40000000000003" as="geometry"/></mxCell><mxCell id="MU-sig-out" value="출력&#xa;대조 사례 [골라짐] 버전(MU-6)&#xa;받는 곳: 게임 구현(GI) 조건부(게임 기획서 없이 시작할 때 닫기 전 사례 대신)&#xa;출력 요구: 같은 사례를 라이브러리와 게임에 돌린 결과. 사례가 읽는 데이터를 만든 레이어 묶음(월드들과 차례,&#xa;Experience, 모드 목록)과 데이터 버전&#xa;게임 실행 결과 파일 [정해짐] 버전(MU-7)&#xa;받는 곳: 게임 구현(GI) 조건부(게임 고침이 그 파일을 만든 규칙을 바꿀 때)&#xa;출력 요구: 골라진 사례를 게임에서 실행해 만든 결과, 그 결과를 만든 레이어 묶음(월드들과 차례, Experience,&#xa;모드 목록)과 데이터 버전, 만든 뒤 게임 코드나 데이터가 바뀌었는지 보는 검사&#xa;맞춘 라이브러리 [QA 통과] 버전&#xa;받는 곳: 컴포넌트 개발(MD) 조건부(맞춘 라이브러리를 부르는 컴포넌트), AI 기능 구현(MI) 조건부(계산이&#xa;게임과 같아야 할 때), 데이터 계약(DC) 조건부(줄이기 DC-2 전에 새 모양으로 옮긴 것)&#xa;출력 요구: 허용할 차이의 근거(게임 소스 파일과 줄)&#xa;게임 쪽 결함과 계약 질문(게임과 대조 MU-5에서 찾은 것)&#xa;받는 곳: 게임 구현(GI) 되돌림&#xa;출력 요구: 상태 이름 밖의 요구 없음" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="736" y="66" width="630" height="288.40000000000003" as="geometry"/></mxCell><mxCell id="MU-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="MU-sig-in" target="MU-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="MU-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="378.40000000000003" width="1382" height="122" as="geometry"/></mxCell></object><object id="MU-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="500.40000000000003" width="1382" height="130" as="geometry"/></mxCell></object><object id="MU-lane-LUE" label="Lead Unreal Engineer" lane="Lead Unreal Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="630.4000000000001" width="1382" height="122" as="geometry"/></mxCell></object><object id="MU-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="752.4000000000001" width="1382" height="122" as="geometry"/></mxCell></object><object id="MU-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-LMTE"><mxGeometry x="166" y="35.00000000000006" width="176" height="60" as="geometry"/></mxCell></object><object id="MU-MU-3" label="게임 근거 정해짐&#xa;(MU-3)&#xa;넘김: 게임이 쓰는 값과 허용할 차이의 소스 파일·줄" step="(MU-3)" owner="Lead Unreal Engineer" approve="없음" input="Lead Designer(허용할 차이에 게임 규칙이 걸릴 때)" handsOver="게임이 쓰는 값과 허용할 차이의 소스 파일·줄" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-LUE"><mxGeometry x="366" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MU-rMU-3LD" label="입력 · 허용할 차이에 게임 규칙이 걸릴 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-LD"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MU-MU-6" label="대조 사례 골라짐&#xa;(MU-6)&#xa;넘김: 테스트 케이스 MD 커밋, QA 계획 코멘트 「과업별 배정」" step="(MU-6)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="테스트 케이스 MD 커밋, QA 계획 코멘트 「과업별 배정」" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-QA"><mxGeometry x="566" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MU-MU-7" label="게임 실행 결과 파일 만들어짐&#xa;(MU-7)&#xa;넘김: 골라진 대조 사례를 게임에서 돌려 만든 게임 실행 결과 파일, 그 파일을 만든 레이어 묶음과 데이터 버전, 만든 뒤 게임 코드나 데이터가 바뀌었는지 보는 검사" step="(MU-7)" owner="Lead Unreal Engineer" approve="없음" input="Lead QA Engineer(사례)" handsOver="골라진 대조 사례를 게임에서 돌려 만든 게임 실행 결과 파일, 그 파일을 만든 레이어 묶음과 데이터 버전, 만든 뒤 게임 코드나 데이터가 바뀌었는지 보는 검사" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-LUE"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MU-rMU-7QA" label="입력 · 사례"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-QA"><mxGeometry x="766" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MU-MU-4" label="라이브러리 만들어짐&#xa;(MU-4)&#xa;넘김: 라이브러리 커밋, 사례 코드" step="(MU-4)" owner="Lead Mod Tool Engineer" approve="없음" input="없음" handsOver="라이브러리 커밋, 사례 코드" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-LMTE"><mxGeometry x="766" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="MU-MU-5" label="게임과 대조됨&#xa;(MU-5)&#xa;넘김: 같은 사례를 라이브러리와 게임에 돌린 결과" step="(MU-5)" owner="Lead QA Engineer" approve="없음" input="Lead Unreal Engineer" handsOver="같은 사례를 라이브러리와 게임에 돌린 결과" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-QA"><mxGeometry x="966" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="MU-rMU-5LUE" label="입력"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-LUE"><mxGeometry x="966" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="MU-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="MU-lane-LMTE"><mxGeometry x="1166" y="35.00000000000006" width="176" height="60" as="geometry"/></mxCell></object><object id="MU-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MU-in" target="MU-MU-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MU-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MU-MU-3" target="MU-MU-6"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MU-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MU-MU-6" target="MU-MU-7"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MU-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MU-MU-6" target="MU-MU-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MU-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MU-MU-7" target="MU-MU-5"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MU-e5" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MU-MU-4" target="MU-MU-5"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="MU-e6" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="MU-MU-5" target="MU-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="MU-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Mod Tool Engineer&#xa;쓰는 때: 도구의 계산이 게임에 이미 있는 규칙과 같게 동작해야 할 때. 질문 「도구의 계산이 게임과 같아야 하는가」&#xa;끝 판정: 대조 사례(MU-6), 게임 실행 결과 파일(MU-7), 게임과 대조(MU-5, 게임 실행 결과 파일 MU-7이 있어야 한다). 보장하는 것: 골라진 대조 사례를 라이브러리와 게임에 똑같이 돌린 결과가 허용한 차이 안에서 같다. 게임 실행 결과 파일은 골라진 사례를 게임에서 돌려 만들었고, 만든 레이어 묶음과 데이터 버전이 적혀 있으며, 만든 뒤 게임 코드나 데이터가 바뀌지 않았다(GRAVEN-2052, GRAVEN-2334)&#xa;정해 둔 자리: 목표 품질: 프로덕션이 바닥이다(Quality.md 「목표 품질을 고르는 기준」). 빠지는 때와 더하는 사용자 확인: 없음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="890.4000000000001" width="1170" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="DC" name="데이터 계약 (DC)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="DC-title" value="데이터 계약 (DC)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="DC-sig-in" value="입력&#xa;데이터 스키마를 바꾸는 기획서 [공동 검토 통과] 버전&#xa;게임 기획(GD), AI 기능 기획(MA), 화면 기획(MP), 컴포넌트 기획(MC) 가운데 그 에픽&#xa;워크플로우에 있는 것 · 조건부(기획서에서 시작할 때)&#xa;요구 기록 현재 버전([승인됨]이나 그 뒤 [정해짐])의 그 만들 것&#xa;줄(결함에서 시작한 요구 포함)&#xa;요구 확정(E-3) · 조건부(기획서 없이 시작할 때)&#xa;바뀌는 표를 읽거나 쓰는 하위의 키와 그 하위가 그 표에서 읽거나 쓸 것&#xa;계획 확정(E-1) · 필수&#xa;새 모양으로 옮긴 읽는 쪽 산출물: 컴포넌트 [넣음] 버전, 진짜 명령·계산&#xa;모듈 [QA 통과] 버전, 맞춘 라이브러리 [QA 통과] 버전, 게임 구현 [QA&#xa;통과] 버전 가운데 그 표를 읽는 것&#xa;컴포넌트 개발(MD), AI 기능 구현(MI), Unreal 맞춤(MU), 게임 구현(GI) · 조건부(줄이기&#xa;DC-2를 할 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="271.5" as="geometry"/></mxCell><mxCell id="DC-sig-out" value="출력&#xa;데이터 계약 [정해짐] 버전과 해시, 스키마 문서 커밋(넓히기 DC-1)&#xa;받는 곳: 명령 계약(MK) 조건부, 컴포넌트 개발(MD) 조건부(바뀐 표를 읽는 컴포넌트), AI&#xa;기능 구현(MI) 조건부(바뀐 표를 읽는 명령·계산), Unreal 맞춤(MU) 조건부(바뀐 표를 읽는&#xa;라이브러리), 게임 구현(GI) 조건부(데이터 스키마가 바뀔 때), 바닐라 데이터(GV)&#xa;조건부(넣을 표의 모양이 바뀔 때)&#xa;출력 요구: 바꾼 표마다 그 표가 놓인 레이어(엔진, 월드, Experience의 모드). 뜻이 바뀐&#xa;칸마다 옛 뜻과 새 뜻(Schema.md D4). 줄이기(DC-2)가 남았는지와 그때 지우거나 조이는 칸&#xa;줄인 데이터 계약 [정해짐] 버전과 스키마 문서 커밋(줄이기 DC-2)&#xa;받는 곳: 에픽 끝(E-2)의 인수. 에픽 밖 묶음이면 그 묶음의 끝&#xa;출력 요구: 줄인 표마다 그 표가 놓인 레이어(엔진, 월드, Experience의 모드)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="271.5" as="geometry"/></mxCell><mxCell id="DC-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="DC-sig-in" target="DC-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="DC-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="361.5" width="1182" height="122" as="geometry"/></mxCell></object><object id="DC-lane-LUE" label="Lead Unreal Engineer" lane="Lead Unreal Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="483.5" width="1182" height="122" as="geometry"/></mxCell></object><object id="DC-lane-LDM" label="Lead Data Modeler" lane="Lead Data Modeler"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="605.5" width="1182" height="130" as="geometry"/></mxCell></object><object id="DC-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="735.5" width="1182" height="122" as="geometry"/></mxCell></object><object id="DC-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LDM"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="DC-DC-1" label="데이터 계약 정해짐(넓히기)&#xa;(DC-1)&#xa;넘김: 데이터 계약 버전과 해시, 바꾼 표마다 놓인 레이어, main 스키마 문서 커밋, 뜻이 바뀐 칸마다 옛 뜻과 새 뜻을 적은 이전 기록, 도구 검사의 결과, 바꾼 표를 게임이 읽으면 게임 시작 검사의 결과, D9 규칙을 바꾼 버전이면 판정 대조 사례의 결과" step="(DC-1)" owner="Lead Data Modeler" approve="없음" input="Lead Unreal Engineer, Lead Mod Tool Engineer, Lead QA Engineer(Schema.md D9의 함께 쓰는 검사 규칙을 바꿀 때. 판정 대조 사례)" handsOver="데이터 계약 버전과 해시, 바꾼 표마다 놓인 레이어, main 스키마 문서 커밋, 뜻이 바뀐 칸마다 옛 뜻과 새 뜻을 적은 이전 기록, 도구 검사의 결과, 바꾼 표를 게임이 읽으면 게임 시작 검사의 결과, D9 규칙을 바꾼 버전이면 판정 대조 사례의 결과" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LDM"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="DC-rDC-1LUE" label="입력"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LUE"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="DC-rDC-1LMTE" label="입력"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LMTE"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="DC-rDC-1QA" label="입력 · Schema.md D9의 함께 쓰는 검사 규칙을 바꿀 때. 판정 대조 사례"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-QA"><mxGeometry x="366" y="18" width="176" height="86" as="geometry"/></mxCell></object><object id="DC-DC-2" label="줄인 데이터 계약 정해짐&#xa;(DC-2)&#xa;넘김: 줄인 데이터 계약 버전, 줄인 표마다 놓인 레이어, main 스키마 문서 커밋, 도구 검사의 결과, 줄인 표를 게임이 읽으면 게임 시작 검사의 결과&#xa;빠지는 때: 지금 읽는 쪽이 따라올 수 있는 변경이면" step="(DC-2)" owner="Lead Data Modeler" approve="없음" input="Lead Unreal Engineer, Lead Mod Tool Engineer" handsOver="줄인 데이터 계약 버전, 줄인 표마다 놓인 레이어, main 스키마 문서 커밋, 도구 검사의 결과, 줄인 표를 게임이 읽으면 게임 시작 검사의 결과" skipWhen="지금 읽는 쪽이 따라올 수 있는 변경이면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LDM"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="DC-rDC-2LUE" label="입력"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LUE"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="DC-rDC-2LMTE" label="입력"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LMTE"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="DC-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="DC-lane-LDM"><mxGeometry x="766" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="DC-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="DC-in" target="DC-DC-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="DC-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="DC-DC-1" target="DC-DC-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="DC-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="DC-DC-2" target="DC-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="DC-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Data Modeler&#xa;쓰는 때: 데이터 스키마가 바뀔 때. 기획서에서 시작하거나, 기획서 없이 결함이나 요구 기록의 줄에서 시작한다. 게임과 모딩 툴이 함께 쓴다. 질문 「저장할 값의 모양(표·칸·레이어)이 바뀌는가」&#xa;끝 판정: 넓히기(DC-1), 고른 때는 줄이기(DC-2). 보장하는 것: 그 버전의 계약과 해시, 바꾼 표마다 놓인 레이어를 맡은 Lead가 적었고, 합친 버전을 지금의 게임과 도구가 읽을 수 있다. 읽을 수 있다는 것은 그 버전의 레포 레이어로 옛 도구: 어드민 툴의 검사(데이터 작업 규칙 D7)와 모딩 툴의 커밋 전 검사가 지났고, 바꾼 표를 게임이 읽으면 게임의 시작 검사가 그 표를 받았다는 뜻이다(같은 규칙 D3·D5). 저장 전 검사와 게임 시작 검사가 함께 쓰는 규칙(같은 규칙 D9)을 바꾼 버전이면 Lead QA Engineer의 판정 대조 사례가 지났다. 줄이기는 그 표를 읽는 쪽이 모두 새 모양으로 옮긴 뒤에 했다&#xa;정해 둔 자리: 목표 품질: 프로덕션이 바닥이다(Quality.md 「목표 품질을 고르는 기준」). 빠지는 때: 줄이기(DC-2)는 지금 읽는 쪽이 따라올 수 있는 변경이면 빠진다. 넓히기와 줄이기로 나눌지는 계획 확정이 낸 하위 목록으로 Lead Data Modeler가 정한다. 더하는 사용자 확인: 없음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="873.5" width="970" height="188" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="PO" name="PoC (PO)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="PO-title" value="PoC (PO)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="PO-sig-in" value="입력&#xa;없음 · 계획 확정(E-1)에서 시작&#xa;에픽 워크플로우가 이 단위 워크플로우를 고르면 시작한다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="118.1" as="geometry"/></mxCell><mxCell id="PO-sig-out" value="출력&#xa;PoC 판정 [판정됨]과 까닭, 판정 자료&#xa;받는 곳: 「가치 있다」면 다음 에픽의 요구 확정(E-3). 같은 에픽에서 만들면 계획 다시&#xa;확정(E-4). 「가치 없다」면 에픽 끝(E-2). 판정과 판정 자료는 게임 기획(GD)의 선택 입력&#xa;출력 요구: 판정에서 나온 요청마다 같은 질문의 「다시」인지 새 질문인지. 레포 밖에 배포한&#xa;판정 자료는 배포 버전과 소스 커밋(위 「산출물의 상태」)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="118.1" as="geometry"/></mxCell><mxCell id="PO-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="PO-sig-in" target="PO-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="PO-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="208.1" width="1182" height="122" as="geometry"/></mxCell></object><object id="PO-lane-JUDGE" label="판정자(목표 품질 문서 「경험의 품질」)" lane="판정자(목표 품질 문서 「경험의 품질」)"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="330.1" width="1182" height="122" as="geometry"/></mxCell></object><object id="PO-lane-PM" label="Lead PM" lane="Lead PM"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="452.1" width="1182" height="122" as="geometry"/></mxCell></object><object id="PO-lane-OWN" label="맡은 Lead(질문을 가진 Lead)" lane="맡은 Lead(질문을 가진 Lead)"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="574.1" width="1182" height="130" as="geometry"/></mxCell></object><object id="PO-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="PO-lane-OWN"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="PO-PO-1" label="질문 적힘&#xa;(PO-1)&#xa;넘김: 질문, 「예」로 볼 조건, 버린다는 것, 이번에 하지 않는 것, 돌릴 자리(사본이나 떼어 둔 곳)" step="(PO-1)" owner="맡은 Lead" approve="사용자(Quality.md 「PoC」가 사용자가 판정한다고 정한 질문일 때)" input="Lead PM(크기)" handsOver="질문, 「예」로 볼 조건, 버린다는 것, 이번에 하지 않는 것, 돌릴 자리(사본이나 떼어 둔 곳)" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="PO-lane-OWN"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="PO-rPO-1U" label="승인 · Quality.md 「PoC」가 사용자가 판정한다고 정한 질문일 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="PO-lane-U"><mxGeometry x="366" y="18" width="176" height="86" as="geometry"/></mxCell></object><object id="PO-rPO-1PM" label="입력 · 크기"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="PO-lane-PM"><mxGeometry x="366" y="33" width="120" height="56" as="geometry"/></mxCell></object><object id="PO-PO-2" label="판정됨&#xa;(PO-2)&#xa;넘김: 판정과 까닭, 판정 자료(아래 「사람이 확인한 예시」)&#xa;Quality.md 「PoC」의 「경험의 품질」이 정한 판정자(맡은 Lead 또는 사용자)" step="(PO-2)" owner="Quality.md 「PoC」의 「경험의 품질」이 정한 판정자(맡은 Lead 또는 사용자)" approve="하는 담당과 같다" input="맡은 Lead(볼 것과 판정 자료)" handsOver="판정과 까닭, 판정 자료(아래 「사람이 확인한 예시」)" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="PO-lane-JUDGE"><mxGeometry x="566" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="PO-rPO-2OWN" label="입력 · 볼 것과 판정 자료"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="PO-lane-OWN"><mxGeometry x="566" y="37" width="176" height="56" as="geometry"/></mxCell></object><object id="PO-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="PO-lane-OWN"><mxGeometry x="766" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="PO-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="PO-in" target="PO-PO-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="PO-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="PO-PO-1" target="PO-PO-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="PO-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="PO-PO-2" target="PO-PO-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="PO-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="PO-PO-2" target="PO-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="PO-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;판정됨에서 질문 적힘으로 돌아가는 화살표: 판정에서 나온 새 질문은 같은 PoC의 질문 적힘에 더하고 Lead PM이 크기를 다시 잰다.&#xa;맡은 Lead: 질문을 가진 Lead&#xa;쓰는 때: Quality.md 「PoC」의 「쓰는 때」에 들 때. PoC 하나는 질문 묶음 하나를 다룬다&#xa;끝 판정: PoC 판정(PO-2). 보장하는 것: 판정하는 사람이 그 판정 자료를 보거나 플레이하고 질문에 답했다&#xa;정해 둔 자리: 목표 품질: PoC. 더하는 사용자 확인: Quality.md 「PoC」의 「경험의 품질」이 사용자가 판정한다고 정한 질문이면 질문 적힘(PO-1)과 판정(PO-2)을 사용자가 한다" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="720.1" width="970" height="146" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="GD" name="게임 기획 (GD)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="GD-title" value="게임 기획 (GD)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="GD-sig-in" value="입력&#xa;없음 · 계획 확정(E-1)에서 시작&#xa;에픽 워크플로우가 이 단위 워크플로우를 고르면 시작한다&#xa;PoC 판정 [판정됨]과 판정 자료&#xa;PoC(PO) · 선택(그 생각을 기획서로 만들 때)&#xa;플레이 판정 [판정됨]의 「다르다」와 까닭&#xa;플레이 판정(GP) · 되돌림(원인이 기획서에 있을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="202.60000000000002" as="geometry"/></mxCell><mxCell id="GD-sig-out" value="출력&#xa;게임 기획서 [공동 검토 통과] 버전. 공동 검토가 빠지면 게임 기획서&#xa;[Lead Designer 검수] 버전&#xa;받는 곳: 게임의 모양과 자산(GA) 필수, 게임 구현(GI) 필수, 바닐라 데이터(GV) 필수(이&#xa;에픽이 바닐라 데이터를 바꿀 때), AI 기능 기획(MA) 선택, 화면 기획(MP) 조건부(그 기준&#xa;줄), 데이터 계약(DC) 조건부(데이터 스키마가 바뀔 때)&#xa;출력 요구: 사람이 화면에서 판단하는 기준이 게임의 뜻이면 그 기준을 적은 줄&#xa;닫기 전 사례 [골라짐] 버전&#xa;받는 곳: 게임 구현(GI) 필수&#xa;출력 요구: 닫기 전 사례가 요청하는 관찰 칸. 사례가 읽는 데이터를 만든 레이어&#xa;묶음(월드들과 차례, Experience, 모드 목록)과 데이터 버전" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="202.60000000000002" as="geometry"/></mxCell><mxCell id="GD-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="GD-sig-in" target="GD-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="GD-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="292.6" width="1182" height="130" as="geometry"/></mxCell></object><object id="GD-lane-LUE" label="Lead Unreal Engineer" lane="Lead Unreal Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="422.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="GD-lane-LDM" label="Lead Data Modeler" lane="Lead Data Modeler"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="544.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="GD-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="666.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="GD-lane-ART" label="Lead Art Director" lane="Lead Art Director"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="788.6" width="1182" height="122" as="geometry"/></mxCell></object><object id="GD-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-LD"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GD-GD-1" label="게임 기획서 작성됨&#xa;(GD-1)&#xa;넘김: 기획서 커밋, design 확인 기록, 검토 요청 코멘트" step="(GD-1)" owner="Lead Designer" approve="없음" input="PD(가치 선택을 물을 때)" handsOver="기획서 커밋, design 확인 기록, 검토 요청 코멘트" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-LD"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="GD-GD-2" label="공동 검토됨&#xa;(GD-2)&#xa;넘김: 기획서 [공동 검토 통과] 버전, 담당마다 확인 기록&#xa;빠지는 때: 이미 정한 결정을 옮기기만 할 때" step="(GD-2)" owner="Lead Designer" approve="Lead Unreal Engineer, Lead QA Engineer, Lead Data Modeler(데이터 스키마가 바뀔 때)" input="Lead Art Director(기획서가 플레이어에게 보이고 들리는 것을 바꿀 때)" handsOver="기획서 [공동 검토 통과] 버전, 담당마다 확인 기록" skipWhen="이미 정한 결정을 옮기기만 할 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-LD"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="GD-rGD-2LUE" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-LUE"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="GD-rGD-2QA" label="승인"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-QA"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="GD-rGD-2LDM" label="승인 · 데이터 스키마가 바뀔 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-LDM"><mxGeometry x="566" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="GD-rGD-2ART" label="입력 · 기획서가 플레이어에게 보이고 들리는 것을 바꿀 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-ART"><mxGeometry x="566" y="26" width="176" height="70" as="geometry"/></mxCell></object><object id="GD-GD-3" label="닫기 전 사례 골라짐&#xa;(GD-3)&#xa;넘김: 테스트 케이스 MD 커밋, QA 계획 코멘트 「과업별 배정」, 관찰 칸 요청&#xa;빠지는 때: 그 에픽 워크플로우에 게임 구현이 없을 때" step="(GD-3)" owner="Lead QA Engineer" approve="없음" input="Lead Unreal Engineer(관찰 칸)" handsOver="테스트 케이스 MD 커밋, QA 계획 코멘트 「과업별 배정」, 관찰 칸 요청" skipWhen="그 에픽 워크플로우에 게임 구현이 없을 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-QA"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="GD-rGD-3LUE" label="입력 · 관찰 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-LUE"><mxGeometry x="766" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="GD-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GD-lane-LD"><mxGeometry x="966" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GD-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GD-in" target="GD-GD-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GD-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="GD-GD-1" target="GD-GD-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GD-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="GD-GD-2" target="GD-GD-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GD-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GD-GD-3" target="GD-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="GD-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Designer&#xa;쓰는 때: 게임 규칙·기제·스킬·적·게임 화면처럼 게임 기획서가 원본인 일. 질문 「새 개념이 드는가」, 「게임 규칙의 뜻이나 수치가 바뀌는가」&#xa;끝 판정: 공동 검토(GD-2), 사례(GD-3). 보장하는 것: 승인 담당의 체크리스트 줄마다 그 버전의 기획서에 답이 있고 출력 요구가 채워졌으며, 닫기 전 사례가 골라졌다. 공동 검토가 빠지면 끝 판정은 Lead Designer의 검수이고, 보장하는 것은 그 버전을 Lead Designer가 검수했다는 것뿐이다&#xa;정해 둔 자리: 목표 품질: Quality.md 「목표 품질을 고르는 기준」대로 고른다. 빠지는 때: 공동 검토(GD-2)는 기획서가 이미 정한 결정을 옮기기만 하고 새 규칙·수치를 정하지 않을 때 빠진다. 닫기 전 사례(GD-3)는 그 에픽 워크플로우에 게임 구현이 없을 때만 빠진다. 빠지면 계획의 고른 선택에 그 까닭을 적는다. 더하는 사용자 확인: 없음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="926.6" width="970" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="GA" name="게임의 모양과 자산 (GA)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="GA-title" value="게임의 모양과 자산 (GA)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="GA-sig-in" value="입력&#xa;게임 기획서 [공동 검토 통과] 버전. 계획의 고른 선택에 게임 기획의 공동&#xa;검토가 빠진 까닭이 적혀 있으면 게임 기획서 [Lead Designer 검수] 버전&#xa;게임 기획(GD) · 필수. 이미 정한 결정을 옮긴 기획 원본 고침이 자기 검수로 끝난 뒤 모양과&#xa;자산으로 이어졌다(GRAVEN-1823, GRAVEN-1824)&#xa;성능 합격선 [정해짐] 버전&#xa;이미 있는 버전. Lead Unreal Engineer가 정의한다(GRAVEN-2441) · 조건부(게임에 넣을&#xa;자산이고, Lead Unreal Engineer가 성능 합격선을 정의했을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="159.7" as="geometry"/></mxCell><mxCell id="GA-sig-out" value="출력&#xa;자산 계열과 모양 [정해짐] 버전. 화풍·손맛 판정이 걸리면 [승인됨]&#xa;받는 곳: 게임 구현(GI) 조건부(보이고 들리는 것이 바뀔 때), 바닐라 데이터(GV)&#xa;조건부(이펙트 이름과 값을 레이어 데이터에 넣을 때)&#xa;출력 요구: 상태 이름 밖의 요구 없음" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="159.7" as="geometry"/></mxCell><mxCell id="GA-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="GA-sig-in" target="GA-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="GA-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="249.7" width="1182" height="122" as="geometry"/></mxCell></object><object id="GA-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="371.7" width="1182" height="122" as="geometry"/></mxCell></object><object id="GA-lane-ART" label="Lead Art Director" lane="Lead Art Director"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="493.7" width="1182" height="130" as="geometry"/></mxCell></object><object id="GA-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GA-lane-ART"><mxGeometry x="166" y="35.00000000000006" width="176" height="60" as="geometry"/></mxCell></object><object id="GA-GA-1" label="모양과 자산 정해짐&#xa;(GA-1)&#xa;넘김: 자산 계열과 모양 결정 문서(하위 Jira 첨부, 칸은 결정 문서의 하네스). 모든 자산이 따를 기준을 바꾸면 원본 문서의 main 커밋" step="(GA-1)" owner="Lead Art Director" approve="사용자(화풍·손맛 판정이 걸릴 때. 요청에서 계열을 이미 골랐으면 빠진다)" input="Lead Designer(보이고 들리는 것의 뜻)" handsOver="자산 계열과 모양 결정 문서(하위 Jira 첨부, 칸은 결정 문서의 하네스). 모든 자산이 따를 기준을 바꾸면 원본 문서의 main 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="GA-lane-ART"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="GA-rGA-1U" label="승인 · 화풍·손맛 판정이 걸릴 때. 요청에서 계열을 이미 골랐으면 빠진다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GA-lane-U"><mxGeometry x="366" y="18" width="176" height="86" as="geometry"/></mxCell></object><object id="GA-rGA-1LD" label="입력 · 보이고 들리는 것의 뜻"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GA-lane-LD"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="GA-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GA-lane-ART"><mxGeometry x="566" y="35.00000000000006" width="176" height="60" as="geometry"/></mxCell></object><object id="GA-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GA-in" target="GA-GA-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GA-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GA-GA-1" target="GA-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="GA-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Art Director&#xa;쓰는 때: 플레이어에게 보이고 들리는 것이 바뀔 때. 질문 「사람이 보고 듣는 모양이 바뀌는가」&#xa;끝 판정: 모양과 자산 정하기(GA-1). 보장하는 것: 그 버전의 자산 계열과 모양을 맡은 Lead가 적었고, 화풍·손맛 판정이 걸리면 사용자가 봤다&#xa;정해 둔 자리: 목표 품질: Quality.md 「목표 품질을 고르는 기준」대로 고른다. 더하는 사용자 확인: 모양과 자산 정하기(GA-1, 화풍·손맛 판정이 걸릴 때). 빠지는 때: 그 사용자 승인은 사용자가 요청에서 자산 계열을 이미 골랐으면 빠진다" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="639.7" width="970" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="GI" name="게임 구현 (GI)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="GI-title" value="게임 구현 (GI)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="GI-sig-in" value="입력&#xa;넷 가운데 하나: 게임 기획서 [공동 검토 통과] 버전. 계획의 고른 선택에&#xa;게임 기획의 공동 검토가 빠진 까닭이 적혀 있으면 게임 기획서 [Lead&#xa;Designer 검수] 버전. 계약을 고치는 일이면 게임 쪽 결함과 계약&#xa;질문(계약 고침은 이 인스턴스의 기술 계약 정해짐(GI-1)이 낸다). 도구가&#xa;요구한 게임 쪽 변경이면 요구 기록 현재 버전([승인됨]이나 그 뒤&#xa;[정해짐])의 그 출력 줄&#xa;게임 기획서는 게임 기획(GD). 게임 쪽 결함과 계약 질문은 Unreal 맞춤(MU)의 게임과&#xa;대조(MU-5) 되돌림. 요구 기록의 줄은 요구 확정(E-3) · 필수. 미리보기와 게임을 대조한&#xa;Integration QA Engineer가 찾은 결함과 계약 질문으로 게임 하위를 열었다. Lead&#xa;Designer가 계약 v9에 넣을 문장의 뜻을 먼저 확인했고, 그 하위의 Lead Unreal Engineer가&#xa;v9를 올렸다(GRAVEN-2052 본문, GRAVEN-1998, GRAVEN-2052 2026-10-31 21:27,&#xa;GRAVEN-1980 2026-11-02 08:36)&#xa;닫기 전 사례 [골라짐] 버전&#xa;게임 기획(GD). 게임 기획서 없이 시작하면 같은 에픽 Unreal 맞춤(MU)의 대조 사례 [골라짐]&#xa;버전 · 필수&#xa;데이터 계약 [정해짐] 버전&#xa;데이터 계약(DC) · 조건부(데이터 스키마가 바뀔 때)&#xa;자산 계열과 모양 [정해짐] 버전&#xa;게임의 모양과 자산(GA) · 조건부(보이고 들리는 것이 바뀔 때)&#xa;게임 실행 결과 파일 [정해짐] 버전&#xa;Unreal 맞춤(MU) · 조건부(게임 고침이 그 파일을 만든 규칙을 바꿀 때)&#xa;플레이 판정 [판정됨]의 「다르다」와 까닭&#xa;플레이 판정(GP) · 되돌림(원인이 구현에 있을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="440.5" as="geometry"/></mxCell><mxCell id="GI-sig-out" value="출력&#xa;게임 구현 [QA 통과] 버전(main 커밋)&#xa;받는 곳: 플레이 판정(GP) 필수, 바닐라 데이터(GV) 조건부(넣을 행이 이 구현이 새로 만든&#xa;엔진 항목이나 자산을 가리킬 때), 데이터 계약(DC) 조건부(줄이기 DC-2 전에 새 모양으로&#xa;옮긴 것)&#xa;출력 요구: 게임 자산을 바꾸었으면 그 자산을 비추는 모딩 툴 데이터(형상, 미리보기 값)를&#xa;같은 인스턴스에서 맞춰 같은 버전을 가리킨다. 그 하위는 같은 게임 구현 인스턴스 안의&#xa;하위로 Lead Mod Tool Engineer가 맡고, 독립 QA(GI-3)가 두 쪽이 같은 버전을 가리키는지&#xa;함께 본다. 게임 코드의 등록이나 엔진 카탈로그가 모으는 Unreal 자산을 바꾸었으면 엔진&#xa;레이어의 `engine_` 표를 같은 인스턴스에서 다시 뽑아, main 커밋 때 그 표를 코드·자산과&#xa;같게 둔다. 게임이 읽지 않는 `engine_` 표도 같다" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="440.5" as="geometry"/></mxCell><mxCell id="GI-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="GI-sig-in" target="GI-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="GI-lane-U" label="사용자" lane="사용자"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="530.5" width="1182" height="122" as="geometry"/></mxCell></object><object id="GI-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="652.5" width="1182" height="122" as="geometry"/></mxCell></object><object id="GI-lane-LMTE" label="Lead Mod Tool Engineer" lane="Lead Mod Tool Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="774.5" width="1182" height="122" as="geometry"/></mxCell></object><object id="GI-lane-LUE" label="Lead Unreal Engineer" lane="Lead Unreal Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="896.5" width="1182" height="130" as="geometry"/></mxCell></object><object id="GI-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1026.5" width="1182" height="122" as="geometry"/></mxCell></object><object id="GI-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-LUE"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GI-GI-1" label="기술 계약 정해짐&#xa;(GI-1)&#xa;넘김: Jira 현재 계약 코멘트의 버전. 계약을 고치는 일이면 새 버전과 바뀐 조항" step="(GI-1)" owner="Lead Unreal Engineer" approve="없음" input="Lead QA Engineer(관찰 칸), Lead Designer(계약을 고치는 일이면 계약에 넣을 문장의 게임 뜻)" handsOver="Jira 현재 계약 코멘트의 버전. 계약을 고치는 일이면 새 버전과 바뀐 조항" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-LUE"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="GI-rGI-1QA" label="입력 · 관찰 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-QA"><mxGeometry x="366" y="33" width="176" height="56" as="geometry"/></mxCell></object><object id="GI-rGI-1LD" label="입력 · 계약을 고치는 일이면 계약에 넣을 문장의 게임 뜻"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-LD"><mxGeometry x="366" y="26" width="176" height="70" as="geometry"/></mxCell></object><object id="GI-GI-2" label="구현됨&#xa;(GI-2)&#xa;넘김: 구현 커밋, 개발 종료 코멘트(목록 사례 통과), unreal 확인 기록 「구현에서 확인했나」. 게임 코드의 등록이나 엔진 카탈로그가 모으는 Unreal 자산을 바꿨으면 다시 뽑은 엔진 카탈로그(엔진 레이어 db 커밋). Unreal 자산을 더하거나 바꿨으면 도구 밖 자세 자료를 반입 도구로 다시 반입한 커밋" step="(GI-2)" owner="Lead Unreal Engineer" approve="없음" input="없음" handsOver="구현 커밋, 개발 종료 코멘트(목록 사례 통과), unreal 확인 기록 「구현에서 확인했나」. 게임 코드의 등록이나 엔진 카탈로그가 모으는 Unreal 자산을 바꿨으면 다시 뽑은 엔진 카탈로그(엔진 레이어 db 커밋). Unreal 자산을 더하거나 바꿨으면 도구 밖 자세 자료를 반입 도구로 다시 반입한 커밋" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-LUE"><mxGeometry x="566" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="GI-GI-3" label="독립 QA 판정됨&#xa;(GI-3)&#xa;넘김: QA 판정 코멘트와 원증거, qa 확인 기록 「QA에서 확인했나」" step="(GI-3)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="QA 판정 코멘트와 원증거, qa 확인 기록 「QA에서 확인했나」" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-QA"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="GI-GI-4" label="구현한 자산의 모양 판정됨&#xa;(GI-4)&#xa;넘김: 판정과 까닭&#xa;빠지는 때: 계획 때 고르지 않았으면" step="(GI-4)" owner="사용자" approve="사용자" input="Lead Unreal Engineer(main 커밋 전에 그 모양을 사용자에게 보인다. 보는 방법은 Lead Unreal Engineer가 정한다)" handsOver="판정과 까닭" skipWhen="계획 때 고르지 않았으면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-U"><mxGeometry x="766" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="GI-rGI-4LUE" label="입력 · main 커밋 전에 그 모양을 사용자에게 보인다. 보는 방법은 Lead Unreal Engineer가 정한다"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-LUE"><mxGeometry x="766" y="10" width="176" height="110" as="geometry"/></mxCell></object><object id="GI-mtdata" label="모딩 툴 데이터를 게임 자산과 맞춤&#xa;같은 게임 구현 인스턴스 안의 하위. 게임 자산을 바꾸었을 때"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-LMTE"><mxGeometry x="566" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="GI-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GI-lane-LUE"><mxGeometry x="966" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GI-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GI-in" target="GI-GI-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GI-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GI-GI-1" target="GI-GI-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GI-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GI-GI-2" target="GI-GI-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GI-e3" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="GI-GI-2" target="GI-GI-4"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GI-e4" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GI-GI-3" target="GI-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GI-e5" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="GI-GI-4" target="GI-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GI-e6" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="GI-GI-1" target="GI-mtdata"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GI-e7" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="GI-mtdata" target="GI-GI-3"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="GI-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Unreal Engineer&#xa;쓰는 때: 게임에 만들거나 고칠 때. 질문 「게임이 실행 중에 하는 동작이 바뀌는가」&#xa;시작 조건: Lead Unreal Engineer는 시작 코멘트에 닫기 전 사례를 읽고 받는다고 적는다. 고칠 줄이 있으면 사례 단계로 되돌린다. 사례 단계에 받는 쪽의 합의를 끝 조건으로 넣자 셋이 서로 기다렸고, 그 확인을 받는 쪽 시작으로 옮기자 풀렸다(GRAVEN-2055 판단 19·22)&#xa;끝 판정: 독립 QA(GI-3). 고른 때는 모양 판정(GI-4)도. 둘 다 main 커밋 전에 끝난다. 보장하는 것: 그 버전이 닫기 전 사례를 지났고, 고른 때는 사용자가 main 커밋 전에 구현한 자산의 모양을 보고 맞다고 봤다&#xa;정해 둔 자리: 목표 품질: 프로덕션이 바닥이다(Quality.md 「목표 품질을 고르는 기준」). 더하는 사용자 확인: 모양 판정(GI-4). 보이는 모양이 바뀌고 그 모양이 구현한 자산에서만 보이며, 그 모양이 새 종류일 때 고른다. 같은 종류면 고르지 않고 독립 QA(GI-3)가 기준 사례로 판정한다(Quality.md 「경험의 품질」)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="1164.5" width="970" height="188" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="GV" name="바닐라 데이터 (GV)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="GV-title" value="바닐라 데이터 (GV)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="GV-sig-in" value="입력&#xa;게임 기획서 [공동 검토 통과] 버전. 계획의 고른 선택에 게임 기획의 공동&#xa;검토가 빠진 까닭이 적혀 있으면 게임 기획서 [Lead Designer 검수] 버전&#xa;게임 기획(GD) · 필수&#xa;데이터 계약 [정해짐] 버전과 스키마 문서 커밋&#xa;데이터 계약(DC) · 조건부(넣을 표의 모양이 바뀔 때)&#xa;게임 구현 [QA 통과] 버전&#xa;게임 구현(GI) · 조건부(넣을 행이 그 구현이 새로 만든 엔진 항목이나 자산을 가리킬 때)&#xa;자산 계열과 모양 [정해짐] 버전&#xa;게임의 모양과 자산(GA) · 조건부(이펙트 이름과 값을 레이어 데이터에 넣을 때)&#xa;플레이 판정 [판정됨]의 「다르다」와 까닭&#xa;플레이 판정(GP) · 되돌림(원인이 바닐라 값에 있을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="244.2" as="geometry"/></mxCell><mxCell id="GV-sig-out" value="출력&#xa;바닐라 데이터 [QA 통과] 버전(레이어 db의 main 커밋)&#xa;받는 곳: 플레이 판정(GP) 조건부(이 에픽이 바닐라 데이터를 바꿨을 때), 플레이 판정이&#xa;없으면 에픽 끝(E-2)&#xa;출력 요구: 넣은 레이어(우리 월드, Experience의 바닐라 모드. 지금 구현에서는 base도&#xa;든다)와 표마다 넣고 고치고 지운 행. 손맛에 닿는 값은 판정 전의 예비 값이라는 것과 판정한&#xa;사람(Quality.md 「경험의 품질」)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="244.2" as="geometry"/></mxCell><mxCell id="GV-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="GV-sig-in" target="GV-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="GV-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="334.2" width="1182" height="130" as="geometry"/></mxCell></object><object id="GV-lane-QA" label="Lead QA Engineer" lane="Lead QA Engineer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="464.2" width="1182" height="122" as="geometry"/></mxCell></object><object id="GV-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GV-lane-LD"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GV-GV-1" label="바닐라 데이터 넣음&#xa;(GV-1)&#xa;넘김: 넣은 레이어 db의 커밋, 표마다 넣고 고치고 지운 행, 모딩 툴(지금은 옛 도구: 어드민 툴) 검사의 결과" step="(GV-1)" owner="Lead Designer" approve="없음" input="없음" handsOver="넣은 레이어 db의 커밋, 표마다 넣고 고치고 지운 행, 모딩 툴(지금은 옛 도구: 어드민 툴) 검사의 결과" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="GV-lane-LD"><mxGeometry x="366" y="9" width="176" height="112" as="geometry"/></mxCell></object><object id="GV-GV-2" label="독립 QA 판정됨&#xa;(GV-2)&#xa;넘김: QA 판정 코멘트와 원증거(게임 시작 검사의 불러오기 보고 포함)" step="(GV-2)" owner="Lead QA Engineer" approve="없음" input="없음" handsOver="QA 판정 코멘트와 원증거(게임 시작 검사의 불러오기 보고 포함)" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="GV-lane-QA"><mxGeometry x="566" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="GV-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GV-lane-LD"><mxGeometry x="766" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GV-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GV-in" target="GV-GV-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GV-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GV-GV-1" target="GV-GV-2"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GV-e2" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GV-GV-2" target="GV-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="GV-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Designer&#xa;쓰는 때: 우리 월드와 Experience의 바닐라 모드에 행을 넣거나 고치거나 지울 때. 게임 규칙의 수치와 스킬·기제·적의 값처럼 기획이 정하는 값이 여기에 든다&#xa;끝 판정: 독립 QA(GV-2). 보장하는 것: 그 버전의 레이어를 쌓아 합친 최종본을 모딩 툴(지금은 옛 도구: 어드민 툴)의 검사와 게임의 시작 검사가 받았고, 넣은 행이 기획서의 값과 같다&#xa;정해 둔 자리: 목표 품질: 프로덕션이 바닥이다. 게임이 읽는 진짜 데이터이기 때문이다(Quality.md 「목표 품질을 고르는 기준」). 손맛에 닿는 값은 프로덕션이어도 판정 전에는 예비 값이다(Quality.md 「경험의 품질」). 더하는 사용자 확인: 없음. 사람의 판정은 플레이 판정이 받는다" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="602.2" width="970" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="GP" name="플레이 판정 (GP)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="GP-title" value="플레이 판정 (GP)&#xa;위 「입력」과 「출력」은 다른 단위 워크플로우에 보이는 정보이고, 아래 레인의 단계는 이 단위 워크플로우만 아는 정보다. 다른 단위 워크플로우와는 「입력」과 「출력」으로만 잇는다." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="GP-sig-in" value="입력&#xa;게임 구현 [QA 통과] 버전&#xa;게임 구현(GI). 그 에픽 워크플로우에 게임 구현이 없으면 이미 있는 버전 · 필수&#xa;바닐라 데이터 [QA 통과] 버전&#xa;바닐라 데이터(GV) · 조건부(이 에픽이 바닐라 데이터를 바꿨을 때)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e0f8;strokeColor=#8064c8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="66" width="530" height="118.1" as="geometry"/></mxCell><mxCell id="GP-sig-out" value="출력&#xa;플레이 판정 [판정됨]과 까닭&#xa;받는 곳: 「다르다」면 원인에 따라 게임 기획(GD), 게임 구현(GI), 바닐라 데이터(GV)의&#xa;되돌림. 「맞다」면 에픽 끝(E-2). 판정 예시는 「사람이 확인한 예시」 자리&#xa;출력 요구: 무엇과 나란히 놓고 보았는지, 판정, 그 판정을 가른 까닭(아래 「사람이 확인한&#xa;예시」)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fde4c8;strokeColor=#d08a2e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="636" y="66" width="530" height="118.1" as="geometry"/></mxCell><mxCell id="GP-sig-arrow" style="endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1" source="GP-sig-in" target="GP-sig-out"><mxGeometry relative="1" as="geometry"/></mxCell><object id="GP-lane-JUDGE" label="판정자(목표 품질 문서 「경험의 품질」)" lane="판정자(목표 품질 문서 「경험의 품질」)"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="208.1" width="1182" height="122" as="geometry"/></mxCell></object><object id="GP-lane-LD" label="Lead Designer" lane="Lead Designer"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="330.1" width="1182" height="130" as="geometry"/></mxCell></object><object id="GP-in" label="시작&#xa;입력은 위 「입력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GP-lane-LD"><mxGeometry x="166" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GP-GP-1" label="사람이 플레이로 판정함&#xa;(GP-1)&#xa;넘김: 판정과 까닭&#xa;Quality.md 「경험의 품질」이 정한 판정자" step="(GP-1)" owner="Quality.md 「경험의 품질」이 정한 판정자" approve="하는 담당과 같다" input="Lead Designer(볼 장면)" handsOver="판정과 까닭" skipWhen="없음"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="GP-lane-JUDGE"><mxGeometry x="366" y="5" width="176" height="112" as="geometry"/></mxCell></object><object id="GP-rGP-1LD" label="입력 · 볼 장면"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="GP-lane-LD"><mxGeometry x="366" y="37" width="176" height="56" as="geometry"/></mxCell></object><object id="GP-out" label="끝&#xa;출력은 위 「출력」 칸"><mxCell style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=11;verticalAlign=middle;" vertex="1" parent="GP-lane-LD"><mxGeometry x="566" y="35" width="176" height="60" as="geometry"/></mxCell></object><object id="GP-e0" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GP-in" target="GP-GP-1"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="GP-e1" label="" carries=""><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="GP-GP-1" target="GP-out"><mxGeometry relative="1" as="geometry"/></mxCell></object><mxCell id="GP-n0" value="정의 표&#xa;보는 법: 노랑은 사람의 판정, 파랑은 공동 검토, 초록은 QA. 점선 테두리 단계는 계획 때 고르거나 빠지는 때가 있다. 회색 점선 상자는 그 단계에서 그 담당의 역할(승인, 입력). 출력은 그 출력의 끝 판정이 끝나면 나간다.&#xa;맡은 Lead: Lead Designer&#xa;쓰는 때: 사람이 플레이로 재미와 손맛을 판정할 때&#xa;끝 판정: 플레이 판정(GP-1). 보장하는 것: GP-1 행의 판정하는 사람이 그 버전의 그 장면을 플레이하고 맞다·다르다고 봤다&#xa;정해 둔 자리: 목표 품질: 없음. 사람의 판정이다. 누가 판정하는지는 GP-1 행이 정한다. 이 판정이 에픽의 마지막 출력이면 에픽 끝의 사용자 확인과 한 번에 받는다" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="166" y="476.1" width="970" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>