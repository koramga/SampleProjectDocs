<mxfile host="GRAVEN-2356-gen" type="device"><diagram id="S" name="워크플로우 목록과 기본 에픽 워크플로우"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="S-title" value="워크플로우 목록과 기본 에픽 워크플로우&#xa;화살표 글은 넘어가는 산출물 [상태]다. 줄마다 기본 에픽 워크플로우 하나. 상자 하나가 단위 워크플로우 하나이고, 점선 상자는 조건이 맞을 때만 든다. 「×대상」은 대상마다 인스턴스 하나(기본은 하위 하나). PoC가 「가치 있다」면 그 생각을 만드는 일은 다음 에픽의 요구 확정으로 간다(같은 에픽이면 계획 다시 확정)." style="text;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="2850" height="50" as="geometry"/></mxCell><object id="S-lane-c1" label="새 모딩 툴 화면" lane="새 모딩 툴 화면"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2882" height="300" as="geometry"/></mxCell></object><object id="S-lane-c3" label="컴포넌트 하나" lane="컴포넌트 하나"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="370" width="2882" height="110" as="geometry"/></mxCell></object><object id="S-lane-c5" label="게임에 맞춘 계산" lane="게임에 맞춘 계산"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="2882" height="110" as="geometry"/></mxCell></object><object id="S-lane-c6" label="게임 기제" lane="게임 기제"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="2882" height="180" as="geometry"/></mxCell></object><object id="S-lane-c7" label="PoC" lane="PoC"><mxCell style="swimlane;horizontal=0;startSize=150;fillColor=#f0f0f0;swimlaneFillColor=none;strokeColor=#ccc