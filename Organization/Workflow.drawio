1mc"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e2" label="MCP 기획서 [공동 검토 통과]" carries="MCP 기획서 [공동 검토 통과]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c1a" target="S-c1mk"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e3" label="기획서 [공동 검토 통과](데이터 스키마가 바뀔 때)" carries="기획서 [공동 검토 통과](데이터 스키마가 바뀔 때)"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c1a" target="S-c1dc"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e4" label="데이터 계약 [정해짐]" carries="데이터 계약 [정해짐]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c1dc" target="S-c1mk"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e5" label="명령 계약 [정해짐]·명령 층 사례 [골라짐]" carries="명령 계약 [정해짐]·명령 층 사례 [골라짐]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c1mk" target="S-c1mi"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e6" label="컴포넌트 기획서 [공동 검토 통과]·컴포넌트 사례 [골라짐]" carries="컴포넌트 기획서 [공동 검토 통과]·컴포넌트 사례 [골라짐]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;" edge="1" parent="1" source="S-c1mc" target="S-c1md"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e7" label="맞춘 라이브러리 [QA 통과]" carries="맞춘 라이브러리 [QA 통과]"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;fontSize=9;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="S-c1mu" target="S-c1md"><mxGeometry relative="1" as="geometry"/></mxCell></object><object id="S-e8" label="가짜 명령 [사례 통과]